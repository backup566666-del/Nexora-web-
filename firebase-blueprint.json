      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Subscription transaction receipts and error logs."
    },
    "/customisation_catalog/{itemId}": {
      "schema": { "$ref": "#/entities/CustomisationCatalogItem" },
      "description": "Admin-managed profile customisation Studio items and tier locks."
    }
  }
}
