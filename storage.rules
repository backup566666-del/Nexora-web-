rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedInVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAllowedMedia() {
      return request.resource.size <= 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp|gif)') ||
          request.resource.contentType.matches('video/(mp4|webm|quicktime)') ||
          request.resource.contentType.matches('audio/(webm|mpeg|wav|ogg)') ||
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('text/plain')
        );
    }

    match /users/{userId}/{allMedia=**} {
      allow read: if request.auth != null;
      allow write: if isSignedInVerified() && request.auth.uid == userId && isAllowedMedia();
    }

    match /posts/{userId}/{allMedia=**} {
      allow read: if request.auth != null;
      allow write: if isSignedInVerified() && request.auth.uid == userId && isAllowedMedia();
    }

    match /stories/{userId}/{allMedia=**} {
      allow read: if request.auth != null;
      allow write: if isSignedInVerified() && request.auth.uid == userId && isAllowedMedia();
    }

    match /vibes/{userId}/{allMedia=**} {
      allow read: if request.auth != null;
      allow write: if isSignedInVerified() && request.auth.uid == userId && isAllowedMedia();
    }

    match /spaces/{spaceId}/{allMedia=**} {
      allow read: if request.auth != null;
      allow write: if isSignedInVerified() && isAllowedMedia();
    }

    match /chat/{convId}/{userId}/{allMedia=**} {
      allow read: if request.auth != null;
      allow write: if isSignedInVerified() && request.auth.uid == userId && isAllowedMedia();
    }
  }
}
