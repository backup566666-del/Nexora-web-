    function isValidWalletTransaction(data) {
      return data.keys().hasAll([
          'uid', 'type', 'direction', 'points', 'referenceId',
          'description', 'actorUid', 'balanceAfterAvailable', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'type', 'direction', 'points', 'nairaEquivalent', 'pointRateNaira',
          'referenceId', 'description', 'actorUid', 'balanceAfterAvailable', 'createdAt'
        ])
        && isValidId(data.uid)
        && data.type in ['referral_milestone', 'task_reward', 'admin_credit', 'admin_debit', 'withdrawal_lock', 'withdrawal_refund', 'withdrawal_paid']
        && data.direction in ['credit', 'debit']
        && data.points is number && data.points > 0
        && (!('nairaEquivalent' in data) || data.nairaEquivalent == null || (data.nairaEquivalent is number && data.nairaEquivalent >= 0))
        && (!('pointRateNaira' in data) || data.pointRateNaira == null || (data.pointRateNaira is number && data.pointRateNaira > 0))
        && data.referenceId is string && data.referenceId.size() >= 1 && data.referenceId.size() <= 128
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 300
        && isValidId(data.actorUid)
