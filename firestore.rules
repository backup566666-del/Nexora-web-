        && isOptionalString(data, 'imageUrl', 400000)
        && data.sortOrder is int && data.sortOrder >= 0
        && isOptionalString(data, 'updatedBy', 128)
        && data.updatedAt is timestamp;
    }

    function isValidAIConversation(data) {
      return data.keys().hasAll(['uid', 'title', 'model', 'saveHistory', 'messageCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'title', 'model', 'saveHistory', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.model in ['gemini-4-hydrogen', 'gemini-3.1-flash-lite', 'gemini-4-neon', 'gemini-4-carbon']
        && data.saveHistory is bool
        && isOptionalString(data, 'lastMessagePreview', 240)
        && data.messageCount is int && data.messageCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
