    function isValidAIMessage(data) {
      return data.keys().hasAll(['convId', 'uid', 'role', 'text', 'createdAt'])
        && data.keys().hasOnly(['convId', 'uid', 'role', 'text', 'model', 'promptTokens', 'outputTokens', 'totalTokens', 'estimatedCostUsd', 'createdAt'])
