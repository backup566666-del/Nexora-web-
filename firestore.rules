        && data.minWithdrawalNaira is number && data.minWithdrawalNaira >= 100 && data.minWithdrawalNaira <= 10000000
        && data.referralsPerPoint is int && data.referralsPerPoint >= 1 && data.referralsPerPoint <= 1000
