rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation probe (used strictly at app boot)
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Cryptographic Firebase Auth email anchor for the permanent Nexora Founder/Owner
    function isFounderOwner() {
      return isVerified() && request.auth.token.email == 'backup566666@gmail.com';
    }

    function hasRoleDoc() {
      return exists(/databases/$(database)/documents/platform_roles/$(request.auth.uid));
    }

    function roleDoc() {
      return get(/databases/$(database)/documents/platform_roles/$(request.auth.uid)).data;
    }

    function isActiveStaff() {
      return isVerified() && hasRoleDoc() && roleDoc().active == true;
    }

    function isPlatformOwner() {
      return isFounderOwner() || (isActiveStaff() && roleDoc().role == 'owner');
    }

    function hasPerm(perm) {
      return isPlatformOwner() || (isActiveStaff() && roleDoc().role in ['administrator', 'moderator', 'verification_reviewer', 'support'] && perm in roleDoc().permissions);
    }

    function isTargetPlatformOwner(uid) {
      return exists(/databases/$(database)/documents/platform_roles/$(uid))
        && get(/databases/$(database)/documents/platform_roles/$(uid)).data.role == 'owner';
    }

    function isNotSuspended() {
      return isFounderOwner()
        || !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !('suspended' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended != true;
    }

    function isAdmin() {
      return isPlatformOwner()
        || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
        || (isActiveStaff() && roleDoc().role in ['owner', 'administrator', 'moderator']);
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isBoundedStringList(arr, maxItems, maxItemLen) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen));
    }

    function isAllValidBadgeValue(val) {
      return val in [
        'verified_identity', 'founder', 'official_organization', 'official_media',
        'creator', 'influencer', 'artist', 'professional', 'educator', 'journalist',
        'community_founder', 'community_leader', 'moderator', 'community_champion',
        'early_member', 'pioneer', 'top_contributor', 'trendsetter', 'supporter', 'legend',
        'owner', 'verified', 'partner', 'founder_circle'
      ];
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'username', 'verified', 'onboardingCompleted',
          'followersCount', 'followingCount', 'postsCount', 'likesCount',
          'isOnline', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'username', 'bio', 'avatarUrl', 'coverUrl',
          'coverPositionY', 'website', 'location', 'interests', 'verified',
          'suspended', 'suspendedReason', 'suspendedAt',
          'onboardingCompleted', 'followersCount', 'followingCount', 'postsCount',
          'likesCount', 'isOnline', 'lastActiveAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 30 && data.username.matches('^[a-z0-9_]+$')
        && isOptionalString(data, 'bio', 400)
        && isOptionalString(data, 'avatarUrl', 200000)
        && isOptionalString(data, 'coverUrl', 400000)
        && (!('coverPositionY' in data) || (data.coverPositionY is number && data.coverPositionY >= 0 && data.coverPositionY <= 100))
        && isOptionalString(data, 'website', 200)
        && isOptionalString(data, 'location', 100)
        && (!('interests' in data) || isBoundedStringList(data.interests, 10, 40))
        && data.verified is bool
        && (!('suspended' in data) || data.suspended is bool)
        && isOptionalString(data, 'suspendedReason', 300)
        && (!('suspendedAt' in data) || data.suspendedAt is timestamp)
        && data.onboardingCompleted is bool
        && data.followersCount is int && data.followersCount >= 0
        && data.followingCount is int && data.followingCount >= 0
        && data.postsCount is int && data.postsCount >= 0
        && data.likesCount is int && data.likesCount >= 0
        && data.isOnline is bool
        && (!('lastActiveAt' in data) || data.lastActiveAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'blockedUserIds', 'privacySettings', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'blockedUserIds', 'privacySettings', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() <= 254
        && isBoundedStringList(data.blockedUserIds, 100, 128)
        && data.privacySettings is map
        && data.privacySettings.keys().hasAll(['profileVisibility', 'storyPrivacy', 'allowDMs', 'showOnlineStatus'])
        && data.privacySettings.keys().hasOnly([
          'profileVisibility', 'storyPrivacy', 'allowDMs', 'showOnlineStatus',
          'allowTags', 'allowCollaborations', 'emailNotifications', 'inAppNotifications'
        ])
        && data.privacySettings.profileVisibility in ['public', 'followers']
        && data.privacySettings.storyPrivacy in ['public', 'followers', 'close']
        && data.privacySettings.allowDMs in ['everyone', 'followers']
        && data.privacySettings.showOnlineStatus is bool
        && (!('allowTags' in data.privacySettings) || data.privacySettings.allowTags in ['everyone', 'followers', 'nobody'])
        && (!('allowCollaborations' in data.privacySettings) || data.privacySettings.allowCollaborations in ['everyone', 'followers', 'nobody'])
        && (!('emailNotifications' in data.privacySettings) || data.privacySettings.emailNotifications is map)
        && (!('inAppNotifications' in data.privacySettings) || data.privacySettings.inAppNotifications is map)
        && data.updatedAt is timestamp;
    }

    function isValidUsernameClaim(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt'])
        && isValidId(data.uid)
        && data.createdAt is timestamp;
    }

    function isValidPlatformRole(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'username', 'role',
          'permissions', 'active', 'ownerBadge', 'assignedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'username', 'role',
          'permissions', 'active', 'ownerBadge', 'specialBadge', 'assignedBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 30
        && data.role in ['owner', 'administrator', 'moderator', 'verification_reviewer', 'support']
        && isBoundedStringList(data.permissions, 12, 40)
        && data.active is bool
        && data.ownerBadge is bool
        && isOptionalString(data, 'specialBadge', 40)
        && isValidId(data.assignedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVerifiedBadgeRecord(data) {
      return data.keys().hasAll(['uid', 'badgeType', 'label', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'badgeType', 'label', 'badges', 'labels', 'updatedBy', 'updatedAt'])
        && isValidId(data.uid)
        && isAllValidBadgeValue(data.badgeType)
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 60
        && (!('badges' in data) || isBoundedStringList(data.badges, 20, 40))
        && (!('labels' in data) || isBoundedStringList(data.labels, 20, 60))
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidBadgeConfig(data) {
      return data.keys().hasAll([
          'badgeId', 'enabled', 'autoAward', 'minFollowers', 'minPosts',
          'minLikes', 'accountAgeDays', 'customCriteriaNote', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'badgeId', 'enabled', 'autoAward', 'minFollowers', 'minPosts',
          'minLikes', 'accountAgeDays', 'customCriteriaNote', 'updatedBy', 'updatedAt'
        ])
        && isAllValidBadgeValue(data.badgeId)
        && data.enabled is bool
        && data.autoAward is bool
        && data.minFollowers is int && data.minFollowers >= 0
        && data.minPosts is int && data.minPosts >= 0
        && data.minLikes is int && data.minLikes >= 0
        && data.accountAgeDays is int && data.accountAgeDays >= 0
        && data.customCriteriaNote is string && data.customCriteriaNote.size() <= 300
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidVerificationRequest(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'username', 'requestedBadge',
          'category', 'rationale', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'username', 'avatarUrl', 'requestedBadge',
          'category', 'rationale', 'referenceLink', 'status',
          'reviewerUid', 'reviewerNote', 'reviewedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 30
        && isOptionalString(data, 'avatarUrl', 200000)
        && data.requestedBadge in [
          'verified', 'creator', 'partner', 'official_organization', 'official_media',
          'influencer', 'artist', 'professional', 'educator', 'journalist',
          'community_founder', 'community_leader', 'community_champion', 'supporter', 'verified_identity'
        ]
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.rationale is string && data.rationale.size() >= 1 && data.rationale.size() <= 600
        && isOptionalString(data, 'referenceLink', 200)
        && data.status in ['pending', 'approved', 'rejected']
        && isOptionalString(data, 'reviewerUid', 128)
        && isOptionalString(data, 'reviewerNote', 300)
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIdentityVerification(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'username', 'legalFullName', 'documentType',
          'documentCountry', 'documentPreviewUrl', 'documentFileName', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'username', 'legalFullName', 'documentType',
          'documentCountry', 'documentPreviewUrl', 'documentFileName', 'status',
          'reviewerUid', 'reviewerNote', 'reviewedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 30
        && data.legalFullName is string && data.legalFullName.size() >= 2 && data.legalFullName.size() <= 100
        && data.documentType in ['passport', 'national_id', 'drivers_license']
        && data.documentCountry is string && data.documentCountry.size() >= 2 && data.documentCountry.size() <= 80
        && data.documentPreviewUrl is string && data.documentPreviewUrl.size() >= 1 && data.documentPreviewUrl.size() <= 450000
        && data.documentFileName is string && data.documentFileName.size() >= 1 && data.documentFileName.size() <= 120
        && data.status in ['pending', 'approved', 'rejected']
        && isOptionalString(data, 'reviewerUid', 128)
        && isOptionalString(data, 'reviewerNote', 300)
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlatformConfig(data) {
      return data.keys().hasAll([
          'platformName', 'slogan', 'description', 'logoMode', 'supportEmail',
          'maintenanceMode', 'maintenanceMessage', 'features', 'contentPolicy', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'platformName', 'slogan', 'description', 'logoMode', 'supportEmail',
          'maintenanceMode', 'maintenanceMessage', 'features', 'contentPolicy', 'updatedBy', 'updatedAt'
        ])
        && data.platformName is string && data.platformName.size() >= 2 && data.platformName.size() <= 60
        && data.slogan is string && data.slogan.size() >= 2 && data.slogan.size() <= 120
        && data.description is string && data.description.size() <= 400
        && data.logoMode in ['standard', 'minimal', 'monochrome']
        && data.supportEmail is string && data.supportEmail.size() <= 120
        && data.maintenanceMode is bool
        && data.maintenanceMessage is string && data.maintenanceMessage.size() <= 300
        && data.features is map
        && data.features.keys().hasAll([
          'registrationOpen', 'communityApprovalRequired', 'vibesEnabled',
          'spacesEnabled', 'chatEnabled', 'storiesEnabled'
        ])
        && data.features.keys().hasOnly([
          'registrationOpen', 'communityApprovalRequired', 'vibesEnabled',
          'spacesEnabled', 'chatEnabled', 'storiesEnabled'
        ])
        && data.features.registrationOpen is bool
        && data.features.communityApprovalRequired is bool
        && data.features.vibesEnabled is bool
        && data.features.spacesEnabled is bool
        && data.features.chatEnabled is bool
        && data.features.storiesEnabled is bool
        && data.contentPolicy is string && data.contentPolicy.size() <= 2000
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidPlatformAnnouncement(data) {
      return data.keys().hasAll(['title', 'message', 'severity', 'active', 'authorUid', 'authorName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'message', 'severity', 'active', 'authorUid', 'authorName', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 500
        && data.severity in ['info', 'warning', 'security']
        && data.active is bool
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorName', 'actorRole', 'action', 'category', 'targetType', 'targetId', 'result', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorName', 'actorRole', 'action', 'category', 'targetType', 'targetId', 'targetLabel', 'result', 'details', 'createdAt'])
        && isValidId(data.actorUid)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
        && data.actorRole is string && data.actorRole.size() >= 1 && data.actorRole.size() <= 40
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 100
        && data.category in ['admin', 'community', 'verification', 'identity', 'platform', 'moderation', 'notification']
        && data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 40
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && isOptionalString(data, 'targetLabel', 120)
        && data.result in ['success', 'rejected']
        && isOptionalString(data, 'details', 400)
        && data.createdAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'authorUsername', 'authorVerified',
          'type', 'text', 'audience', 'likesCount', 'commentsCount',
          'repostsCount', 'savesCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId', 'authorName', 'authorUsername', 'authorAvatar', 'authorVerified',
          'spaceId', 'spaceName', 'type', 'text', 'mediaUrls', 'mediaTypes',
          'hashtags', 'mentions', 'taggedUids', 'taggedUsernames',
          'collaboratorInviteUids', 'collaboratorUids', 'declinedCollaboratorUids',
          'collaboratorProfiles', 'giftsCount',
          'location', 'audience', 'pollOptions',
          'pollCounts', 'repostOfId', 'likesCount', 'commentsCount',
          'repostsCount', 'savesCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 30
        && isOptionalString(data, 'authorAvatar', 200000)
        && data.authorVerified is bool
        && isOptionalString(data, 'spaceId', 128)
        && isOptionalString(data, 'spaceName', 80)
        && data.type in ['text', 'photo', 'video', 'poll', 'repost']
        && data.text is string && data.text.size() <= 2000
        && (!('mediaUrls' in data) || isBoundedStringList(data.mediaUrls, 4, 400000))
        && (!('mediaTypes' in data) || isBoundedStringList(data.mediaTypes, 4, 20))
        && (!('hashtags' in data) || isBoundedStringList(data.hashtags, 10, 40))
        && (!('mentions' in data) || isBoundedStringList(data.mentions, 10, 40))
        && (!('taggedUids' in data) || isBoundedStringList(data.taggedUids, 10, 128))
        && (!('taggedUsernames' in data) || isBoundedStringList(data.taggedUsernames, 10, 40))
        && (!('collaboratorInviteUids' in data) || isBoundedStringList(data.collaboratorInviteUids, 5, 128))
        && (!('collaboratorUids' in data) || isBoundedStringList(data.collaboratorUids, 5, 128))
        && (!('declinedCollaboratorUids' in data) || isBoundedStringList(data.declinedCollaboratorUids, 5, 128))
        && (!('collaboratorProfiles' in data) || data.collaboratorProfiles is map)
        && (!('giftsCount' in data) || (data.giftsCount is int && data.giftsCount >= 0))
        && isOptionalString(data, 'location', 100)
        && data.audience in ['public', 'followers', 'space']
        && (!('pollOptions' in data) || isBoundedStringList(data.pollOptions, 4, 100))
        && (!('pollCounts' in data) || (data.pollCounts is list && data.pollCounts.size() <= 4 && (data.pollCounts.size() == 0 || data.pollCounts[0] is int)))
        && isOptionalString(data, 'repostOfId', 128)
        && data.likesCount is int && data.likesCount >= 0
        && data.commentsCount is int && data.commentsCount >= 0
        && data.repostsCount is int && data.repostsCount >= 0
        && data.savesCount is int && data.savesCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPostLike(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt'])
        && isValidId(data.uid)
        && data.createdAt is timestamp;
    }

    function isValidPostComment(data) {
      return data.keys().hasAll(['postId', 'authorId', 'authorName', 'authorUsername', 'text', 'createdAt'])
        && data.keys().hasOnly(['postId', 'authorId', 'authorName', 'authorUsername', 'authorAvatar', 'authorVerified', 'parentCommentId', 'text', 'createdAt'])
        && isValidId(data.postId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 30
        && isOptionalString(data, 'authorAvatar', 200000)
        && (!('authorVerified' in data) || data.authorVerified is bool)
        && isOptionalString(data, 'parentCommentId', 128)
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidPostVote(data) {
      return data.keys().hasAll(['uid', 'optionIndex', 'createdAt'])
        && data.keys().hasOnly(['uid', 'optionIndex', 'createdAt'])
        && isValidId(data.uid)
        && data.optionIndex is int && data.optionIndex >= 0 && data.optionIndex <= 3
        && data.createdAt is timestamp;
    }

    function isValidSavedPost(data) {
      return data.keys().hasAll(['postId', 'savedAt'])
        && data.keys().hasOnly(['postId', 'savedAt'])
        && isValidId(data.postId)
        && data.savedAt is timestamp;
    }

    function isValidFollowEdge(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt'])
        && isValidId(data.uid)
        && data.createdAt is timestamp;
    }

    function isValidStory(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'authorUsername', 'type', 'privacy', 'viewsCount', 'createdAt', 'expiresAt'])
        && data.keys().hasOnly(['authorId', 'authorName', 'authorUsername', 'authorAvatar', 'authorVerified', 'type', 'text', 'mediaUrl', 'bgGradient', 'privacy', 'viewsCount', 'createdAt', 'expiresAt'])
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 30
        && isOptionalString(data, 'authorAvatar', 200000)
        && (!('authorVerified' in data) || data.authorVerified is bool)
        && data.type in ['image', 'video', 'text']
        && isOptionalString(data, 'text', 500)
        && isOptionalString(data, 'mediaUrl', 400000)
        && isOptionalString(data, 'bgGradient', 100)
        && data.privacy in ['public', 'followers', 'close']
        && data.viewsCount is int && data.viewsCount >= 0
        && data.createdAt is timestamp
        && data.expiresAt is timestamp;
    }

    function isValidStoryView(data) {
      return data.keys().hasAll(['uid', 'viewerName', 'viewedAt'])
        && data.keys().hasOnly(['uid', 'viewerName', 'viewerAvatar', 'reaction', 'viewedAt'])
        && isValidId(data.uid)
        && data.viewerName is string && data.viewerName.size() >= 1 && data.viewerName.size() <= 80
        && isOptionalString(data, 'viewerAvatar', 200000)
        && isOptionalString(data, 'reaction', 20)
        && data.viewedAt is timestamp;
    }

    function isValidVibe(data) {
      return data.keys().hasAll([
          'authorId', 'authorName', 'authorUsername', 'videoUrl', 'caption',
          'likesCount', 'commentsCount', 'repostsCount', 'savesCount', 'viewsCount',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId', 'authorName', 'authorUsername', 'authorAvatar', 'authorVerified',
          'videoUrl', 'thumbnailUrl', 'caption', 'hashtags', 'audioTrack',
          'filterPreset', 'textOverlay', 'trimStart', 'trimEnd', 'duration',
          'likesCount', 'commentsCount', 'repostsCount', 'savesCount', 'viewsCount',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 30
        && isOptionalString(data, 'authorAvatar', 200000)
        && (!('authorVerified' in data) || data.authorVerified is bool)
        && data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 500000
        && isOptionalString(data, 'thumbnailUrl', 300000)
        && data.caption is string && data.caption.size() <= 400
        && (!('hashtags' in data) || isBoundedStringList(data.hashtags, 10, 40))
        && isOptionalString(data, 'audioTrack', 120)
        && isOptionalString(data, 'filterPreset', 40)
        && isOptionalString(data, 'textOverlay', 120)
        && (!('trimStart' in data) || (data.trimStart is number && data.trimStart >= 0))
        && (!('trimEnd' in data) || (data.trimEnd is number && data.trimEnd >= 0))
        && (!('duration' in data) || (data.duration is number && data.duration >= 0))
        && data.likesCount is int && data.likesCount >= 0
        && data.commentsCount is int && data.commentsCount >= 0
        && data.repostsCount is int && data.repostsCount >= 0
        && data.savesCount is int && data.savesCount >= 0
        && data.viewsCount is int && data.viewsCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSpace(data) {
      return data.keys().hasAll([
          'name', 'slug', 'description', 'category', 'ownerId', 'ownerName',
          'ownerUsername', 'verified', 'membersCount', 'isPrivate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'slug', 'description', 'category', 'coverUrl', 'coverPositionY',
          'ownerId', 'ownerName', 'ownerUsername', 'verified', 'status', 'suspensionReason',
          'membersCount', 'isPrivate', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 60
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 400
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && isOptionalString(data, 'coverUrl', 400000)
        && (!('coverPositionY' in data) || (data.coverPositionY is number && data.coverPositionY >= 0 && data.coverPositionY <= 100))
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
        && data.ownerUsername is string && data.ownerUsername.size() >= 3 && data.ownerUsername.size() <= 30
        && data.verified is bool
        && (!('status' in data) || data.status in ['active', 'pending', 'suspended'])
        && isOptionalString(data, 'suspensionReason', 300)
        && data.membersCount is int && data.membersCount >= 0
        && data.isPrivate is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSpaceMember(data) {
      return data.keys().hasAll(['uid', 'role', 'displayName', 'username', 'joinedAt'])
        && data.keys().hasOnly(['uid', 'role', 'displayName', 'username', 'avatarUrl', 'joinedAt'])
        && isValidId(data.uid)
        && data.role in ['owner', 'admin', 'member']
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 30
        && isOptionalString(data, 'avatarUrl', 200000)
        && data.joinedAt is timestamp;
    }

    function isValidSpaceDiscussion(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'text', 'channel', 'createdAt'])
        && data.keys().hasOnly(['authorId', 'authorName', 'authorAvatar', 'text', 'channel', 'createdAt'])
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && isOptionalString(data, 'authorAvatar', 200000)
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.channel is string && data.channel.size() >= 1 && data.channel.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidSpaceEvent(data) {
      return data.keys().hasAll(['title', 'scheduledFor', 'hostId', 'hostName', 'createdAt'])
        && data.keys().hasOnly(['title', 'description', 'scheduledFor', 'hostId', 'hostName', 'createdAt'])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && isOptionalString(data, 'description', 400)
        && data.scheduledFor is string && data.scheduledFor.size() >= 1 && data.scheduledFor.size() <= 60
        && isValidId(data.hostId)
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['isGroup', 'participantIds', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['isGroup', 'title', 'participantIds', 'participantNames', 'participantAvatars', 'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'readBy', 'typingBy', 'createdBy', 'createdAt', 'updatedAt'])
        && data.isGroup is bool
        && isOptionalString(data, 'title', 80)
        && data.participantIds is list && data.participantIds.size() >= 2 && data.participantIds.size() <= 20
        && data.participantIds[0] is string && data.participantIds[1] is string
        && (!('participantNames' in data) || data.participantNames is map)
        && (!('participantAvatars' in data) || data.participantAvatars is map)
        && isOptionalString(data, 'lastMessageText', 300)
        && isOptionalString(data, 'lastMessageSenderId', 128)
        && (!('lastMessageAt' in data) || data.lastMessageAt is timestamp)
        && (!('readBy' in data) || data.readBy is map)
        && (!('typingBy' in data) || data.typingBy is map)
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'type', 'text', 'edited', 'deleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['senderId', 'senderName', 'type', 'text', 'mediaUrl', 'fileName', 'replyToId', 'replyToText', 'reactions', 'edited', 'deleted', 'createdAt', 'updatedAt'])
        && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.type in ['text', 'image', 'video', 'voice', 'document']
        && data.text is string && data.text.size() <= 2000
        && isOptionalString(data, 'mediaUrl', 500000)
        && isOptionalString(data, 'fileName', 120)
        && isOptionalString(data, 'replyToId', 128)
        && isOptionalString(data, 'replyToText', 200)
        && (!('reactions' in data) || data.reactions is map)
        && data.edited is bool
        && data.deleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientId', 'actorId', 'actorName', 'type', 'read', 'createdAt'])
        && data.keys().hasOnly(['recipientId', 'actorId', 'actorName', 'actorAvatar', 'type', 'category', 'targetId', 'preview', 'read', 'createdAt'])
        && isValidId(data.recipientId)
        && isValidId(data.actorId)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
        && isOptionalString(data, 'actorAvatar', 200000)
        && data.type in [
          'like', 'comment', 'follow', 'repost', 'space_invite', 'message',
          'announcement', 'security_alert', 'admin_notice',
          'badge_awarded', 'badge_revoked', 'identity_decision', 'staff_role_change',
          'community_status', 'verification_decision', 'collab_invite', 'collab_response',
          'post_tag', 'gift_received', 'support_ticket'
        ]
        && (!('category' in data) || data.category in ['account', 'social', 'badges', 'gifts', 'admin', 'security'])
        && isOptionalString(data, 'targetId', 128)
        && isOptionalString(data, 'preview', 200)
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reporterId', 'targetType', 'targetId', 'reason', 'createdAt'])
        && data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'reason', 'status', 'resolutionNote', 'resolvedBy', 'resolvedAt', 'createdAt'])
        && isValidId(data.reporterId)
        && data.targetType in ['post', 'user', 'space', 'vibe', 'gift', 'collab']
        && isValidId(data.targetId)
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300
        && (!('status' in data) || data.status in ['open', 'resolved', 'dismissed'])
        && isOptionalString(data, 'resolutionNote', 300)
        && isOptionalString(data, 'resolvedBy', 128)
        && (!('resolvedAt' in data) || data.resolvedAt is timestamp)
        && data.createdAt is timestamp;
    }

    function isValidGiftCatalogItem(data) {
      return data.keys().hasAll([
          'name', 'description', 'emoji', 'category', 'accentColor',
          'tier', 'enabled', 'sortOrder', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'description', 'emoji', 'category', 'accentColor',
          'tier', 'enabled', 'sortOrder', 'createdBy', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.description is string && data.description.size() <= 200
        && data.emoji is string && data.emoji.size() >= 1 && data.emoji.size() <= 16
        && data.category in ['celebration', 'creator', 'community', 'appreciation']
        && data.accentColor is string && data.accentColor.size() >= 3 && data.accentColor.size() <= 24
        && data.tier in ['free', 'future_premium']
        && data.enabled is bool
        && data.sortOrder is int && data.sortOrder >= 0
        && isOptionalString(data, 'createdBy', 128)
        && data.updatedAt is timestamp;
    }

    function isValidGiftTransaction(data) {
      return data.keys().hasAll([
          'giftId', 'giftName', 'giftEmoji', 'giftAccent', 'senderUid',
          'senderName', 'senderUsername', 'recipientUid', 'recipientName',
          'recipientUsername', 'targetType', 'targetId', 'anonymous', 'createdAt'
        ])
        && data.keys().hasOnly([
          'giftId', 'giftName', 'giftEmoji', 'giftAccent', 'senderUid',
          'senderName', 'senderUsername', 'senderAvatar', 'recipientUid',
          'recipientName', 'recipientUsername', 'targetType', 'targetId',
          'message', 'anonymous', 'createdAt'
        ])
        && isValidId(data.giftId)
        && data.giftName is string && data.giftName.size() >= 1 && data.giftName.size() <= 60
        && data.giftEmoji is string && data.giftEmoji.size() >= 1 && data.giftEmoji.size() <= 16
        && data.giftAccent is string && data.giftAccent.size() >= 3 && data.giftAccent.size() <= 24
        && isValidId(data.senderUid)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.senderUsername is string && data.senderUsername.size() >= 3 && data.senderUsername.size() <= 30
        && isOptionalString(data, 'senderAvatar', 200000)
        && isValidId(data.recipientUid)
        && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 80
        && data.recipientUsername is string && data.recipientUsername.size() >= 3 && data.recipientUsername.size() <= 30
        && data.targetType in ['profile', 'post']
        && isValidId(data.targetId)
        && isOptionalString(data, 'message', 240)
        && data.anonymous is bool
        && data.createdAt is timestamp;
    }

    function isValidEmailLog(data) {
      return data.keys().hasAll([
          'recipientEmailMasked', 'eventType', 'category', 'subject',
          'provider', 'status', 'actorUid', 'createdAt'
        ])
        && data.keys().hasOnly([
          'recipientUid', 'recipientEmailMasked', 'eventType', 'category',
          'subject', 'provider', 'status', 'error', 'actorUid', 'createdAt'
        ])
        && isOptionalString(data, 'recipientUid', 128)
        && data.recipientEmailMasked is string && data.recipientEmailMasked.size() >= 1 && data.recipientEmailMasked.size() <= 120
        && data.eventType is string && data.eventType.size() >= 1 && data.eventType.size() <= 60
        && data.category in ['account', 'social', 'badges', 'gifts', 'admin', 'security']
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 160
        && data.provider in ['resend', 'smtp', 'none']
        && data.status in ['sent', 'not_configured', 'skipped', 'failed']
        && isOptionalString(data, 'error', 240)
        && isValidId(data.actorUid)
        && data.createdAt is timestamp;
    }

    function isValidContactSubmission(data) {
      return data.keys().hasAll([
          'name', 'email', 'category', 'subject', 'message',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'category', 'subject', 'message',
          'status', 'adminNote', 'handledBy', 'handledAt', 'createdAt', 'updatedAt'
        ])
        && isOptionalString(data, 'uid', 128)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.category in ['support', 'appeal', 'verification_help', 'bug', 'partnership']
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 120
        && data.message is string && data.message.size() >= 4 && data.message.size() <= 1500
        && data.status in ['open', 'in_review', 'resolved']
        && isOptionalString(data, 'adminNote', 300)
        && isOptionalString(data, 'handledBy', 128)
        && (!('handledAt' in data) || data.handledAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
    }

    // Private RBAC Staff Registry
    match /platform_roles/{userId} {
      allow get: if isValidId(userId) && isVerified() && (
        isOwner(userId) || isPlatformOwner() || hasPerm('manage_admins')
      );
      allow list: if isVerified() && (isPlatformOwner() || hasPerm('manage_admins'))
        && existing().role in ['owner', 'administrator', 'moderator', 'verification_reviewer', 'support'];

      allow create: if isValidId(userId)
        && isVerified()
        && isValidPlatformRole(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isFounderOwner() && isOwner(userId) && incoming().role == 'owner' && incoming().ownerBadge == true && incoming().active == true) ||
          (isPlatformOwner() && incoming().role in ['administrator', 'moderator', 'verification_reviewer', 'support'] && incoming().ownerBadge == false) ||
          (hasPerm('manage_admins') && incoming().role in ['moderator', 'verification_reviewer', 'support'] && incoming().ownerBadge == false)
        );

      allow update: if isValidId(userId)
        && isVerified()
        && isValidPlatformRole(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isFounderOwner() && isOwner(userId) && incoming().role == 'owner' && incoming().ownerBadge == true && incoming().active == true) ||
          (
            existing().role != 'owner'
            && incoming().ownerBadge == false
            && (
              (isPlatformOwner() && incoming().role in ['administrator', 'moderator', 'verification_reviewer', 'support']) ||
              (hasPerm('manage_admins') && existing().role in ['moderator', 'verification_reviewer', 'support'] && incoming().role in ['moderator', 'verification_reviewer', 'support'])
            )
          )
        );

      allow delete: if isValidId(userId)
        && isVerified()
        && existing().role != 'owner'
        && (
          isPlatformOwner() ||
          (hasPerm('manage_admins') && existing().role in ['moderator', 'verification_reviewer', 'support'])
        );
    }

    // Public Zero-PII Trusted 20-Badge Registry
    match /verified_badges/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn() && existing().badgeType in [
        'verified_identity', 'founder', 'official_organization', 'official_media',
        'creator', 'influencer', 'artist', 'professional', 'educator', 'journalist',
        'community_founder', 'community_leader', 'moderator', 'community_champion',
        'early_member', 'pioneer', 'top_contributor', 'trendsetter', 'supporter', 'legend',
        'owner', 'verified', 'partner', 'founder_circle'
      ];

      allow create, update: if isValidId(userId)
        && isVerified()
        && isValidVerifiedBadgeRecord(incoming())
        && incoming().uid == userId
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          (isFounderOwner() && isOwner(userId) && incoming().badgeType in ['owner', 'founder']) ||
          (
            !(incoming().badgeType in ['owner', 'founder'])
            && !isTargetPlatformOwner(userId)
            && (
              isPlatformOwner() ||
              hasPerm('manage_verification') ||
              (hasPerm('review_identity_docs') && incoming().badgeType == 'verified_identity')
            )
          )
        );

      allow delete: if isValidId(userId)
        && isVerified()
        && !(existing().badgeType in ['owner', 'founder'])
        && !isTargetPlatformOwner(userId)
        && (isPlatformOwner() || hasPerm('manage_verification'));
    }

    // Administrative Badge Rules & Achievement Thresholds
    match /badge_configs/{badgeId} {
      allow get: if isValidId(badgeId) && isSignedIn();
      allow list: if isSignedIn() && existing().enabled in [true, false];

      allow create, update: if isValidId(badgeId)
        && isVerified()
        && isValidBadgeConfig(incoming())
        && incoming().badgeId == badgeId
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_verification'));
    }

    // Verification Applications
    match /verification_requests/{requestId} {
      allow get: if isValidId(requestId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_verification')
      );
      allow list: if isVerified() && (
        isOwner(existing().uid) ||
        ((isPlatformOwner() || hasPerm('manage_verification')) && existing().status in ['pending', 'approved', 'rejected'])
      );

      allow create: if isValidId(requestId)
        && isVerified()
        && isNotSuspended()
        && isValidVerificationRequest(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && !('reviewerUid' in incoming())
        && !('reviewerNote' in incoming())
        && !('reviewedAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(requestId)
        && isVerified()
        && isValidVerificationRequest(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_verification'))
        && incoming().reviewerUid == request.auth.uid;

      allow delete: if isValidId(requestId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_verification')
      );
    }

    // Confidential Identity Verification Documents
    match /identity_verifications/{requestId} {
      allow get: if isValidId(requestId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('review_identity_docs')
      );
      allow list: if isVerified() && (
        isOwner(existing().uid) ||
        ((isPlatformOwner() || hasPerm('review_identity_docs')) && existing().status in ['pending', 'approved', 'rejected'])
      );

      allow create: if isValidId(requestId)
        && isVerified()
        && isNotSuspended()
        && isValidIdentityVerification(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && !('reviewerUid' in incoming())
        && !('reviewerNote' in incoming())
        && !('reviewedAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(requestId)
        && isVerified()
        && isValidIdentityVerification(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('review_identity_docs'))
        && incoming().reviewerUid == request.auth.uid;

      allow delete: if isValidId(requestId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner()
      );
    }

    // Platform Global Settings
    match /platform_config/{configId} {
      allow get: if isValidId(configId) && configId == 'global';
      allow create, update: if isValidId(configId)
        && configId == 'global'
        && isVerified()
        && isValidPlatformConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform'));
    }

    // Platform Announcements
    match /platform_announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isSignedIn();
      allow list: if isSignedIn() && existing().active in [true, false];

      allow create: if isValidId(announcementId)
        && isVerified()
        && isValidPlatformAnnouncement(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('manage_notifications'));

      allow update: if isValidId(announcementId)
        && isVerified()
        && isValidPlatformAnnouncement(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('manage_notifications'));

      allow delete: if isValidId(announcementId) && isVerified()
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('manage_notifications'));
    }

    // Immutable Audit Logs
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isVerified() && (isPlatformOwner() || hasPerm('view_audit_logs') || hasPerm('manage_admins'));
      allow list: if isVerified() && (isPlatformOwner() || hasPerm('view_audit_logs') || hasPerm('manage_admins'))
        && existing().category in ['admin', 'community', 'verification', 'identity', 'platform', 'moderation', 'notification'];

      allow create: if isValidId(logId)
        && isVerified()
        && isValidAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time
        && (isPlatformOwner() || isActiveStaff());

      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isSignedIn() || existing().onboardingCompleted == true);
      allow list: if isSignedIn() && existing().onboardingCompleted in [true, false];

      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && (incoming().verified == false || isFounderOwner())
        && (!('suspended' in incoming()) || incoming().suspended == false)
        && incoming().followersCount == 0
        && incoming().followingCount == 0
        && incoming().postsCount == 0
        && incoming().likesCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isFounderOwner() && isOwner(userId) && (!('suspended' in incoming()) || incoming().suspended == false)) ||
          (
            !isTargetPlatformOwner(userId)
            && isPlatformOwner()
          ) ||
          (
            !isTargetPlatformOwner(userId)
            && (hasPerm('manage_verification') || hasPerm('review_identity_docs'))
            && incoming().diff(existing()).affectedKeys().hasOnly(['verified', 'updatedAt'])
          ) ||
          (
            !isTargetPlatformOwner(userId)
            && hasPerm('moderate_content')
            && incoming().verified == existing().verified
            && incoming().diff(existing()).affectedKeys().hasOnly(['suspended', 'suspendedReason', 'suspendedAt', 'updatedAt'])
          ) ||
          (
            isOwner(userId)
            && isNotSuspended()
            && incoming().verified == existing().verified
            && (!('suspended' in incoming()) ? !('suspended' in existing()) : ('suspended' in existing() && incoming().suspended == existing().suspended))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'username', 'bio', 'avatarUrl', 'coverUrl',
              'coverPositionY', 'website', 'location', 'interests',
              'onboardingCompleted', 'isOnline', 'lastActiveAt', 'postsCount',
              'followingCount', 'updatedAt'
            ])
          ) ||
          (
            incoming().verified == existing().verified
            && (!('suspended' in incoming()) ? !('suspended' in existing()) : ('suspended' in existing() && incoming().suspended == existing().suspended))
            && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'likesCount', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isPlatformOwner() && !isTargetPlatformOwner(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(docId) && isOwner(userId)
          && isValidUserPrivate(incoming())
          && incoming().uid == userId
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) && isOwner(userId)
          && isValidUserPrivate(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'blockedUserIds', 'privacySettings', 'updatedAt']);
      }

      match /saved/{postId} {
        allow get: if isValidId(userId) && isValidId(postId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(postId) && isVerified() && isOwner(userId)
          && isValidSavedPost(incoming())
          && incoming().postId == postId
          && incoming().savedAt == request.time;
        allow delete: if isValidId(userId) && isValidId(postId) && isVerified() && isOwner(userId);
      }

      match /followers/{followerId} {
        allow get: if isValidId(userId) && isValidId(followerId) && isSignedIn();
        allow list: if isValidId(userId) && isSignedIn();
        allow create: if isValidId(userId) && isValidId(followerId) && isVerified() && isOwner(followerId)
          && isValidFollowEdge(incoming())
          && incoming().uid == followerId
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(followerId) && isVerified() && isOwner(followerId);
      }

      match /following/{targetId} {
        allow get: if isValidId(userId) && isValidId(targetId) && isSignedIn();
        allow list: if isValidId(userId) && isSignedIn();
        allow create: if isValidId(userId) && isValidId(targetId) && isVerified() && isOwner(userId)
          && isValidFollowEdge(incoming())
          && incoming().uid == targetId
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(targetId) && isVerified() && isOwner(userId);
      }
    }

    match /usernames/{username} {
      allow get: if isValidId(username);
      allow create: if isValidId(username) && isVerified()
        && isValidUsernameClaim(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow delete: if isValidId(username) && isVerified() && existing().uid == request.auth.uid;
    }

    match /posts/{postId} {
      allow get: if isValidId(postId) && (existing().audience == 'public' || isSignedIn());
      allow list: if isSignedIn() && existing().audience in ['public', 'followers', 'space'];

      allow create: if isValidId(postId)
        && isVerified()
        && isNotSuspended()
        && isValidPost(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().repostsCount == 0
        && incoming().savesCount == 0
        && (!('giftsCount' in incoming()) || incoming().giftsCount == 0)
        && (!('collaboratorUids' in incoming()) || incoming().collaboratorUids.size() == 0)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(postId)
        && isVerified()
        && isValidPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || hasPerm('moderate_content') ||
          (
            isOwner(existing().authorId)
            && isNotSuspended()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'text', 'location', 'audience', 'hashtags', 'mentions',
              'taggedUids', 'taggedUsernames', 'collaboratorInviteUids', 'collaboratorProfiles', 'updatedAt'
            ])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'likesCount', 'commentsCount', 'repostsCount', 'savesCount', 'pollCounts', 'giftsCount', 'updatedAt'
            ])
          ) ||
          (
            isNotSuspended()
            && 'collaboratorInviteUids' in existing()
            && (request.auth.uid in existing().collaboratorInviteUids || ('collaboratorUids' in existing() && request.auth.uid in existing().collaboratorUids))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'collaboratorUids', 'declinedCollaboratorUids', 'collaboratorProfiles', 'updatedAt'
            ])
          ) ||
          (
            'taggedUids' in existing()
            && request.auth.uid in existing().taggedUids
            && incoming().diff(existing()).affectedKeys().hasOnly(['taggedUids', 'taggedUsernames', 'updatedAt'])
            && !(request.auth.uid in incoming().taggedUids)
          )
        );

      allow delete: if isValidId(postId) && isVerified() && (isOwner(existing().authorId) || isAdmin() || hasPerm('moderate_content'));

      match /likes/{userId} {
        allow get: if isValidId(postId) && isValidId(userId) && isSignedIn();
        allow list: if isValidId(postId) && isSignedIn();
        allow create: if isValidId(postId) && isValidId(userId) && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && isValidPostLike(incoming())
          && incoming().uid == userId
          && incoming().createdAt == request.time;
        allow delete: if isValidId(postId) && isValidId(userId) && isVerified() && isOwner(userId);
      }

      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId) && isSignedIn();
        allow list: if isValidId(postId) && isSignedIn();
        allow create: if isValidId(postId) && isValidId(commentId) && isVerified()
          && isNotSuspended()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && isValidPostComment(incoming())
          && incoming().postId == postId
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(postId) && isValidId(commentId) && isVerified() && (isOwner(existing().authorId) || isAdmin() || hasPerm('moderate_content'));
      }

      match /votes/{userId} {
        allow get: if isValidId(postId) && isValidId(userId) && isSignedIn();
        allow create: if isValidId(postId) && isValidId(userId) && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && isValidPostVote(incoming())
          && incoming().uid == userId
          && incoming().createdAt == request.time;
      }
    }

    match /stories/{storyId} {
      allow get: if isValidId(storyId) && isSignedIn();
      allow list: if isSignedIn() && existing().privacy in ['public', 'followers', 'close'];

      allow create: if isValidId(storyId)
        && isVerified()
        && isNotSuspended()
        && isValidStory(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().viewsCount == 0
        && incoming().createdAt == request.time;

      allow update: if isValidId(storyId)
        && isVerified()
        && isValidStory(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']);

      allow delete: if isValidId(storyId) && isVerified() && (isOwner(existing().authorId) || isAdmin() || hasPerm('moderate_content'));

      match /views/{viewerId} {
        allow get: if isValidId(storyId) && isValidId(viewerId) && isSignedIn();
        allow list: if isValidId(storyId) && isSignedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid;
        allow create: if isValidId(storyId) && isValidId(viewerId) && isVerified() && isOwner(viewerId)
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && isValidStoryView(incoming())
          && incoming().uid == viewerId
          && incoming().viewedAt == request.time;
        allow update: if isValidId(storyId) && isValidId(viewerId) && isVerified() && isOwner(viewerId)
          && isValidStoryView(incoming())
          && incoming().uid == existing().uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['reaction', 'viewedAt'])
          && incoming().viewedAt == request.time;
      }
    }

    match /vibes/{vibeId} {
      allow get: if isValidId(vibeId);
      allow list: if isSignedIn() && existing().viewsCount >= 0;

      allow create: if isValidId(vibeId)
        && isVerified()
        && isNotSuspended()
        && isValidVibe(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().repostsCount == 0
        && incoming().savesCount == 0
        && incoming().viewsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(vibeId)
        && isVerified()
        && isValidVibe(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || hasPerm('moderate_content') ||
          (
            isOwner(existing().authorId)
            && isNotSuspended()
            && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'hashtags', 'thumbnailUrl', 'updatedAt'])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'repostsCount', 'savesCount', 'viewsCount', 'updatedAt'])
          )
        );

      allow delete: if isValidId(vibeId) && isVerified() && (isOwner(existing().authorId) || isAdmin() || hasPerm('moderate_content'));

      match /likes/{userId} {
        allow get: if isValidId(vibeId) && isValidId(userId) && isSignedIn();
        allow list: if isValidId(vibeId) && isSignedIn();
        allow create: if isValidId(vibeId) && isValidId(userId) && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/vibes/$(vibeId))
          && isValidPostLike(incoming())
          && incoming().uid == userId
          && incoming().createdAt == request.time;
        allow delete: if isValidId(vibeId) && isValidId(userId) && isVerified() && isOwner(userId);
      }

      match /comments/{commentId} {
        allow get: if isValidId(vibeId) && isValidId(commentId) && isSignedIn();
        allow list: if isValidId(vibeId) && isSignedIn();
        allow create: if isValidId(vibeId) && isValidId(commentId) && isVerified()
          && isNotSuspended()
          && exists(/databases/$(database)/documents/vibes/$(vibeId))
          && isValidPostComment(incoming())
          && incoming().postId == vibeId
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(vibeId) && isValidId(commentId) && isVerified() && (isOwner(existing().authorId) || isAdmin() || hasPerm('moderate_content'));
      }
    }

    match /spaces/{spaceId} {
      allow get: if isValidId(spaceId);
      allow list: if isSignedIn() && existing().isPrivate in [false, true];

      allow create: if isValidId(spaceId)
        && isVerified()
        && isNotSuspended()
        && isValidSpace(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().verified == false
        && (!('status' in incoming()) || incoming().status in ['active', 'pending'])
        && incoming().membersCount == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(spaceId)
        && isVerified()
        && isValidSpace(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isPlatformOwner() || hasPerm('manage_communities') ||
          (
            incoming().ownerId == existing().ownerId
            && isOwner(existing().ownerId)
            && isNotSuspended()
            && incoming().verified == existing().verified
            && (!('status' in incoming()) ? !('status' in existing()) : ('status' in existing() && incoming().status == existing().status))
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'category', 'coverUrl', 'coverPositionY', 'isPrivate', 'updatedAt'])
          ) ||
          (
            incoming().ownerId == existing().ownerId
            && incoming().verified == existing().verified
            && (!('status' in incoming()) ? !('status' in existing()) : ('status' in existing() && incoming().status == existing().status))
            && incoming().diff(existing()).affectedKeys().hasOnly(['membersCount', 'updatedAt'])
          )
        );

      allow delete: if isValidId(spaceId) && isVerified() && (
        isOwner(existing().ownerId) || isPlatformOwner() || hasPerm('manage_communities') || hasPerm('moderate_content')
      );

      match /members/{userId} {
        allow get: if isValidId(spaceId) && isValidId(userId) && isSignedIn();
        allow list: if isValidId(spaceId) && isSignedIn();
        allow create: if isValidId(spaceId) && isValidId(userId) && isVerified()
          && (isOwner(userId) || isPlatformOwner() || hasPerm('manage_communities'))
          && (exists(/databases/$(database)/documents/spaces/$(spaceId)) || existsAfter(/databases/$(database)/documents/spaces/$(spaceId)))
          && isValidSpaceMember(incoming())
          && incoming().uid == userId
          && incoming().joinedAt == request.time
          && (
            isPlatformOwner() || hasPerm('manage_communities') ||
            incoming().role == 'member' ||
            (incoming().role == 'owner' && (
              (exists(/databases/$(database)/documents/spaces/$(spaceId)) && get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid) ||
              (existsAfter(/databases/$(database)/documents/spaces/$(spaceId)) && getAfter(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid)
            ))
          );
        allow update: if isValidId(spaceId) && isValidId(userId) && isVerified()
          && isValidSpaceMember(incoming())
          && (
            isPlatformOwner() || hasPerm('manage_communities') ||
            get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid
          )
          && incoming().uid == existing().uid
          && incoming().joinedAt == existing().joinedAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['role']);
        allow delete: if isValidId(spaceId) && isValidId(userId) && isVerified()
          && (
            isOwner(userId) ||
            isPlatformOwner() ||
            hasPerm('manage_communities') ||
            get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid
          );
      }

      match /discussions/{msgId} {
        allow get: if isValidId(spaceId) && isValidId(msgId) && isSignedIn()
          && (exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)) || isPlatformOwner() || hasPerm('moderate_content'));
        allow list: if isValidId(spaceId) && isSignedIn()
          && (exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)) || isPlatformOwner() || hasPerm('moderate_content'));
        allow create: if isValidId(spaceId) && isValidId(msgId) && isVerified()
          && isNotSuspended()
          && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid))
          && isValidSpaceDiscussion(incoming())
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(spaceId) && isValidId(msgId) && isVerified()
          && (isOwner(existing().authorId) || get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid || isPlatformOwner() || hasPerm('moderate_content'));
      }

      match /events/{eventId} {
        allow get: if isValidId(spaceId) && isValidId(eventId) && isSignedIn();
        allow list: if isValidId(spaceId) && isSignedIn();
        allow create: if isValidId(spaceId) && isValidId(eventId) && isVerified()
          && isNotSuspended()
          && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid))
          && isValidSpaceEvent(incoming())
          && incoming().hostId == request.auth.uid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(spaceId) && isValidId(eventId) && isVerified()
          && (isOwner(existing().hostId) || get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid || isPlatformOwner() || hasPerm('manage_communities'));
      }
    }

    match /conversations/{convId} {
      allow get: if isValidId(convId) && isSignedIn() && request.auth.uid in existing().participantIds;
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;

      allow create: if isValidId(convId)
        && isVerified()
        && isNotSuspended()
        && isValidConversation(incoming())
        && incoming().createdBy == request.auth.uid
        && request.auth.uid in incoming().participantIds
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(convId)
        && isVerified()
        && isNotSuspended()
        && isValidConversation(incoming())
        && request.auth.uid in existing().participantIds
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (
          (
            incoming().updatedAt == request.time
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'updatedAt']) ||
              (existing().isGroup == true && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'participantIds', 'participantNames', 'participantAvatars', 'updatedAt']))
            )
          ) ||
          (
            incoming().updatedAt == existing().updatedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'typingBy'])
          )
        );

      match /messages/{messageId} {
        allow get: if isValidId(convId) && isValidId(messageId) && isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow list: if isValidId(convId) && isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;

        allow create: if isValidId(convId) && isValidId(messageId) && isVerified()
          && isNotSuspended()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && isValidChatMessage(incoming())
          && incoming().senderId == request.auth.uid
          && incoming().edited == false
          && incoming().deleted == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(convId) && isValidId(messageId) && isVerified()
          && isNotSuspended()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && isValidChatMessage(incoming())
          && incoming().senderId == existing().senderId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isOwner(existing().senderId) && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'edited', 'deleted', 'updatedAt'])) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'updatedAt'])
          );
      }
    }

    match /notifications/{notifId} {
      allow get: if isValidId(notifId) && isSignedIn() && existing().recipientId == request.auth.uid;
      allow list: if isSignedIn() && existing().recipientId == request.auth.uid;

      allow create: if isValidId(notifId)
        && isVerified()
        && isValidNotification(incoming())
        && incoming().actorId == request.auth.uid
        && incoming().read == false
        && incoming().createdAt == request.time
        && (
          incoming().type in [
            'like', 'comment', 'follow', 'repost', 'space_invite', 'message',
            'collab_invite', 'collab_response', 'post_tag', 'gift_received', 'support_ticket'
          ] ||
          (incoming().type == 'security_alert' && incoming().recipientId == request.auth.uid) ||
          isPlatformOwner() ||
          hasPerm('manage_notifications') ||
          hasPerm('manage_verification') ||
          hasPerm('review_identity_docs') ||
          hasPerm('manage_communities') ||
          hasPerm('manage_admins')
        );

      allow update: if isValidId(notifId)
        && isVerified()
        && isOwner(existing().recipientId)
        && isValidNotification(incoming())
        && incoming().recipientId == existing().recipientId
        && incoming().actorId == existing().actorId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);

      allow delete: if isValidId(notifId) && isVerified() && isOwner(existing().recipientId);
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isVerified() && (
        isOwner(existing().reporterId) || isPlatformOwner() || hasPerm('moderate_content') || hasPerm('manage_communities')
      );
      allow list: if isVerified() && (isPlatformOwner() || hasPerm('moderate_content') || hasPerm('manage_communities'))
        && existing().targetType in ['post', 'user', 'space', 'vibe', 'gift', 'collab'];

      allow create: if isValidId(reportId) && isVerified()
        && isNotSuspended()
        && isValidReport(incoming())
        && incoming().reporterId == request.auth.uid
        && (!('status' in incoming()) || incoming().status == 'open')
        && incoming().createdAt == request.time;

      allow update: if isValidId(reportId) && isVerified()
        && isValidReport(incoming())
        && (isPlatformOwner() || hasPerm('moderate_content') || hasPerm('manage_communities'))
        && incoming().reporterId == existing().reporterId
        && incoming().targetType == existing().targetType
        && incoming().targetId == existing().targetId
        && incoming().createdAt == existing().createdAt
        && incoming().resolvedBy == request.auth.uid
        && incoming().resolvedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolutionNote', 'resolvedBy', 'resolvedAt']);
    }

    // Strictly Free Virtual Gifts Catalog
    match /gift_catalog/{giftId} {
      allow get: if isValidId(giftId) && isSignedIn();
      allow list: if isSignedIn() && existing().tier in ['free', 'future_premium'];

      allow create, update: if isValidId(giftId)
        && isVerified()
        && isValidGiftCatalogItem(incoming())
        && incoming().tier == 'free'
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('moderate_content'));

      allow delete: if isValidId(giftId)
        && isVerified()
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('moderate_content'));
    }

    // Free Virtual Gift Transactions
    match /virtual_gifts/{giftTxId} {
      allow get: if isValidId(giftTxId) && isSignedIn();
      allow list: if isSignedIn() && existing().targetType in ['profile', 'post'];

      allow create: if isValidId(giftTxId)
        && isVerified()
        && isNotSuspended()
        && isValidGiftTransaction(incoming())
        && incoming().senderUid == request.auth.uid
        && incoming().senderUid != incoming().recipientUid
        && incoming().createdAt == request.time;

      allow delete: if isValidId(giftTxId) && isVerified() && (
        isOwner(existing().senderUid) ||
        isOwner(existing().recipientUid) ||
        isPlatformOwner() ||
        hasPerm('moderate_content')
      );
    }

    // Privacy-Masked Email Dispatch Logs
    match /email_logs/{logId} {
      allow get: if isValidId(logId) && isVerified() && (
        isOwner(existing().actorUid) || isPlatformOwner() || hasPerm('manage_notifications') || hasPerm('manage_platform')
      );
      allow list: if isVerified()
        && (isPlatformOwner() || hasPerm('manage_notifications') || hasPerm('manage_platform'))
        && existing().status in ['sent', 'not_configured', 'skipped', 'failed'];

      allow create: if isValidId(logId)
        && isVerified()
        && isValidEmailLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // Support Tickets, Verification Help & Moderation Appeals
    match /contact_submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isVerified() && (
        ('uid' in existing() && isOwner(existing().uid)) ||
        isPlatformOwner() ||
        hasPerm('moderate_content') ||
        hasPerm('manage_notifications')
      );
      allow list: if isVerified()
        && (
          ('uid' in existing() && isOwner(existing().uid)) ||
          ((isPlatformOwner() || hasPerm('moderate_content') || hasPerm('manage_notifications')) && existing().status in ['open', 'in_review', 'resolved'])
        );

      allow create: if isValidId(submissionId)
        && isValidContactSubmission(incoming())
        && incoming().status == 'open'
        && (!('uid' in incoming()) || (isSignedIn() && incoming().uid == request.auth.uid))
        && !('handledBy' in incoming())
        && !('handledAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(submissionId)
        && isVerified()
        && isValidContactSubmission(incoming())
        && (isPlatformOwner() || hasPerm('moderate_content') || hasPerm('manage_notifications'))
        && incoming().createdAt == existing().createdAt
        && incoming().handledBy == request.auth.uid
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(submissionId) && isVerified() && (
        isPlatformOwner() || hasPerm('moderate_content')
      );
    }
  }
}
