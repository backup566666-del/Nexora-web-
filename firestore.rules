    function isValidAIUsage(data) {
      return data.keys().hasAll(['uid', 'dateKey', 'tier', 'requestsCount', 'promptTokens', 'outputTokens', 'totalTokens', 'estimatedCostUsd', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'dateKey', 'tier', 'requestsCount', 'promptTokens', 'outputTokens', 'totalTokens', 'estimatedCostUsd', 'lastRequestMs', 'updatedAt'])
