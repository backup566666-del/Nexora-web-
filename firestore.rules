    function isValidWithdrawalRequest(data) {
      return data.keys().hasAll([
          'uid', 'userDisplayName', 'userUsername', 'pointsRequested', 'pointRateNaira',
          'nairaAmount', 'bankName', 'bankCode', 'accountNumberMasked', 'accountHolderName',
          'accountVerificationStatus', 'verificationProvider', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'userDisplayName', 'userUsername', 'pointsRequested', 'pointRateNaira',
          'nairaAmount', 'bankName', 'bankCode', 'accountNumberMasked', 'accountHolderName',
          'accountVerificationStatus', 'verificationProvider', 'status',
          'paymentReference', 'adminNote', 'reviewedBy', 'paidBy', 'paidAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.userDisplayName is string && data.userDisplayName.size() >= 1 && data.userDisplayName.size() <= 80
        && data.userUsername is string && data.userUsername.size() >= 1 && data.userUsername.size() <= 30
        && data.pointsRequested is number && data.pointsRequested > 0
        && data.pointRateNaira is number && data.pointRateNaira > 0
        && data.nairaAmount is number && data.nairaAmount >= 100
        && data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 100
        && data.bankCode is string && data.bankCode.size() >= 2 && data.bankCode.size() <= 20
        && data.accountNumberMasked is string && data.accountNumberMasked.size() >= 4 && data.accountNumberMasked.size() <= 24
        && data.accountHolderName is string && data.accountHolderName.size() >= 2 && data.accountHolderName.size() <= 120
        && data.accountVerificationStatus in ['verified', 'unverified_manual', 'not_configured']
        && data.verificationProvider in ['paystack', 'flutterwave', 'none']
        && data.status in ['pending', 'under_review', 'approved', 'rejected', 'processing', 'paid']
        && isOptionalString(data, 'paymentReference', 120)
        && isOptionalString(data, 'adminNote', 300)
        && isOptionalString(data, 'reviewedBy', 128)
        && isOptionalString(data, 'paidBy', 128)
        && (!('paidAt' in data) || data.paidAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWithdrawalPrivate(data) {
      return data.keys().hasAll([
          'withdrawalId', 'uid', 'bankName', 'bankCode', 'accountNumber',
          'accountHolderName', 'verificationProvider', 'createdAt'
        ])
        && data.keys().hasOnly([
          'withdrawalId', 'uid', 'bankName', 'bankCode', 'accountNumber',
          'accountHolderName', 'verificationProvider', 'providerResponseSummary', 'createdAt'
        ])
        && isValidId(data.withdrawalId)
        && isValidId(data.uid)
        && data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 100
        && data.bankCode is string && data.bankCode.size() >= 2 && data.bankCode.size() <= 20
        && data.accountNumber is string && data.accountNumber.size() >= 10 && data.accountNumber.size() <= 20 && data.accountNumber.matches('^[0-9]+$')
        && data.accountHolderName is string && data.accountHolderName.size() >= 2 && data.accountHolderName.size() <= 120
        && data.verificationProvider in ['paystack', 'flutterwave', 'none']
        && isOptionalString(data, 'providerResponseSummary', 240)
        && data.createdAt is timestamp;
    }

    function rewardsConfigData() {
      return get(/databases/$(database)/documents/rewards_config/global).data;
    }

    function taskData(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function walletData(uid) {
      return get(/databases/$(database)/documents/wallets/$(uid)).data;
    }

    // --- Collection Rules ---

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
    }

    // Private RBAC Staff Registry
    match /platform_roles/{userId} {
      allow get: if isValidId(userId) && isVerified() && (
        isOwner(userId) || isPlatformOwner() || hasPerm('manage_admins')
      );
      allow list: if isVerified() && (isPlatformOwner() || hasPerm('manage_admins'))
        && existing().role in ['owner', 'administrator', 'moderator', 'verification_reviewer', 'support'];

      allow create: if isValidId(userId)
        && isVerified()
        && isValidPlatformRole(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isFounderOwner() && isOwner(userId) && incoming().role == 'owner' && incoming().ownerBadge == true && incoming().active == true) ||
          (isPlatformOwner() && incoming().role in ['administrator', 'moderator', 'verification_reviewer', 'support'] && incoming().ownerBadge == false) ||
          (hasPerm('manage_admins') && incoming().role in ['moderator', 'verification_reviewer', 'support'] && incoming().ownerBadge == false)
        );

      allow update: if isValidId(userId)
        && isVerified()
        && isValidPlatformRole(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isFounderOwner() && isOwner(userId) && incoming().role == 'owner' && incoming().ownerBadge == true && incoming().active == true) ||
          (
            existing().role != 'owner'
            && incoming().ownerBadge == false
            && (
              (isPlatformOwner() && incoming().role in ['administrator', 'moderator', 'verification_reviewer', 'support']) ||
              (hasPerm('manage_admins') && existing().role in ['moderator', 'verification_reviewer', 'support'] && incoming().role in ['moderator', 'verification_reviewer', 'support'])
            )
          )
        );

      allow delete: if isValidId(userId)
        && isVerified()
        && existing().role != 'owner'
        && (
          isPlatformOwner() ||
          (hasPerm('manage_admins') && existing().role in ['moderator', 'verification_reviewer', 'support'])
        );
    }

    // Public Zero-PII Trusted 20-Badge Registry
    match /verified_badges/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn() && existing().badgeType in [
        'verified_identity', 'founder', 'official_organization', 'official_media',
        'creator', 'influencer', 'artist', 'professional', 'educator', 'journalist',
        'community_founder', 'community_leader', 'moderator', 'community_champion',
        'early_member', 'pioneer', 'top_contributor', 'trendsetter', 'supporter', 'legend',
        'owner', 'verified', 'partner', 'founder_circle'
      ];

      allow create, update: if isValidId(userId)
        && isVerified()
        && isValidVerifiedBadgeRecord(incoming())
        && incoming().uid == userId
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          (isFounderOwner() && isOwner(userId) && incoming().badgeType in ['owner', 'founder']) ||
          (
            !(incoming().badgeType in ['owner', 'founder'])
            && !isTargetPlatformOwner(userId)
            && (
              isPlatformOwner() ||
              hasPerm('manage_verification') ||
              (hasPerm('review_identity_docs') && incoming().badgeType == 'verified_identity')
            )
          )
        );

      allow delete: if isValidId(userId)
        && isVerified()
        && !(existing().badgeType in ['owner', 'founder'])
        && !isTargetPlatformOwner(userId)
        && (isPlatformOwner() || hasPerm('manage_verification'));
    }

    // Administrative Badge Rules & Achievement Thresholds
    match /badge_configs/{badgeId} {
      allow get: if isValidId(badgeId) && isSignedIn();
      allow list: if isSignedIn() && existing().enabled in [true, false];

      allow create, update: if isValidId(badgeId)
        && isVerified()
        && isValidBadgeConfig(incoming())
        && incoming().badgeId == badgeId
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_verification'));
    }

    // Verification Applications
    match /verification_requests/{requestId} {
      allow get: if isValidId(requestId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_verification')
      );
      allow list: if isVerified() && (
        isOwner(existing().uid) ||
        ((isPlatformOwner() || hasPerm('manage_verification')) && existing().status in ['pending', 'approved', 'rejected'])
      );

      allow create: if isValidId(requestId)
        && isVerified()
        && isNotSuspended()
        && isValidVerificationRequest(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && !('reviewerUid' in incoming())
        && !('reviewerNote' in incoming())
        && !('reviewedAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(requestId)
        && isVerified()
        && isValidVerificationRequest(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_verification'))
        && incoming().reviewerUid == request.auth.uid;

      allow delete: if isValidId(requestId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_verification')
      );
    }

    // Confidential Identity Verification Documents
    match /identity_verifications/{requestId} {
      allow get: if isValidId(requestId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('review_identity_docs')
      );
      allow list: if isVerified() && (
        isOwner(existing().uid) ||
        ((isPlatformOwner() || hasPerm('review_identity_docs')) && existing().status in ['pending', 'approved', 'rejected'])
      );

      allow create: if isValidId(requestId)
        && isVerified()
        && isNotSuspended()
        && isValidIdentityVerification(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && !('reviewerUid' in incoming())
        && !('reviewerNote' in incoming())
        && !('reviewedAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(requestId)
        && isVerified()
        && isValidIdentityVerification(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('review_identity_docs'))
        && incoming().reviewerUid == request.auth.uid;

      allow delete: if isValidId(requestId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner()
      );
    }

    // Platform Global Settings
    match /platform_config/{configId} {
      allow get: if isValidId(configId) && configId == 'global';
      allow create, update: if isValidId(configId)
        && configId == 'global'
        && isVerified()
        && isValidPlatformConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform'));
    }

    // Platform Announcements
    match /platform_announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isSignedIn();
      allow list: if isSignedIn() && existing().active in [true, false];

      allow create: if isValidId(announcementId)
        && isVerified()
        && isValidPlatformAnnouncement(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('manage_notifications'));

      allow update: if isValidId(announcementId)
        && isVerified()
        && isValidPlatformAnnouncement(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('manage_notifications'));

      allow delete: if isValidId(announcementId) && isVerified()
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('manage_notifications'));
    }

    // Immutable Audit Logs
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isVerified() && (isPlatformOwner() || hasPerm('view_audit_logs') || hasPerm('manage_admins'));
      allow list: if isVerified() && (isPlatformOwner() || hasPerm('view_audit_logs') || hasPerm('manage_admins'))
        && existing().category in ['admin', 'community', 'verification', 'identity', 'platform', 'moderation', 'notification', 'billing', 'customisation', 'ai', 'rewards', 'wallet'];

      allow create: if isValidId(logId)
        && isVerified()
        && isValidAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time
        && (isPlatformOwner() || isActiveStaff());

      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isSignedIn() || existing().onboardingCompleted == true);
      allow list: if isSignedIn() && existing().onboardingCompleted in [true, false];

      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && (incoming().verified == false || isFounderOwner())
        && (!('suspended' in incoming()) || incoming().suspended == false)
        && (!('subscriptionTier' in incoming()) || incoming().subscriptionTier == 'free')
        && incoming().followersCount == 0
        && incoming().followingCount == 0
        && incoming().postsCount == 0
        && incoming().likesCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isFounderOwner() && isOwner(userId) && (!('suspended' in incoming()) || incoming().suspended == false)) ||
          (
            isOwner(userId)
            && isNotSuspended()
            && incoming().verified == existing().verified
            && (!('suspended' in incoming()) ? !('suspended' in existing()) : ('suspended' in existing() && incoming().suspended == existing().suspended))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'username', 'bio', 'avatarUrl', 'coverUrl',
              'coverPositionY', 'website', 'location', 'interests',
              'onboardingCompleted', 'isOnline', 'lastActiveAt', 'postsCount',
              'followingCount', 'profileCustomisation', 'updatedAt'
            ])
          ) ||
          (
            isOwner(userId)
            && isNotSuspended()
            && incoming().verified == existing().verified
            && (!('suspended' in incoming()) ? !('suspended' in existing()) : ('suspended' in existing() && incoming().suspended == existing().suspended))
            && incoming().diff(existing()).affectedKeys().hasOnly(['subscriptionTier', 'updatedAt'])
            && (
              incoming().subscriptionTier == 'free' ||
              (
                exists(/databases/$(database)/documents/user_subscriptions/$(userId))
                && get(/databases/$(database)/documents/user_subscriptions/$(userId)).data.tier == incoming().subscriptionTier
                && get(/databases/$(database)/documents/user_subscriptions/$(userId)).data.verifiedByServer == true
              )
            )
          ) ||
          (
            !isTargetPlatformOwner(userId)
            && isPlatformOwner()
          ) ||
          (
            !isTargetPlatformOwner(userId)
            && hasPerm('manage_platform')
            && incoming().verified == existing().verified
            && incoming().diff(existing()).affectedKeys().hasOnly(['subscriptionTier', 'updatedAt'])
          ) ||
          (
            !isTargetPlatformOwner(userId)
            && (hasPerm('manage_verification') || hasPerm('review_identity_docs'))
            && incoming().diff(existing()).affectedKeys().hasOnly(['verified', 'updatedAt'])
          ) ||
          (
            !isTargetPlatformOwner(userId)
            && hasPerm('moderate_content')
            && incoming().verified == existing().verified
            && incoming().diff(existing()).affectedKeys().hasOnly(['suspended', 'suspendedReason', 'suspendedAt', 'updatedAt'])
          ) ||
          (
            userId != request.auth.uid
            && isNotSuspended()
            && incoming().verified == existing().verified
            && (!('suspended' in incoming()) ? !('suspended' in existing()) : ('suspended' in existing() && incoming().suspended == existing().suspended))
            && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
            && (
              (
                !exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && incoming().followersCount == existing().followersCount + 1
              ) ||
              (
                exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && (
                  (existing().followersCount > 0 && incoming().followersCount == existing().followersCount - 1) ||
                  (existing().followersCount == 0 && incoming().followersCount == 0)
                )
              )
            )
          ) ||
          (
            incoming().verified == existing().verified
            && (!('suspended' in incoming()) ? !('suspended' in existing()) : ('suspended' in existing() && incoming().suspended == existing().suspended))
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isPlatformOwner() && !isTargetPlatformOwner(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(docId) && isVerified() && isOwner(userId)
          && isValidUserPrivate(incoming())
          && incoming().uid == userId
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) && isVerified() && isOwner(userId)
          && isValidUserPrivate(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'blockedUserIds', 'privacySettings', 'updatedAt']);
      }

      match /saved/{postId} {
        allow get: if isValidId(userId) && isValidId(postId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(postId) && isVerified() && isOwner(userId)
          && isValidSavedPost(incoming())
          && incoming().postId == postId
          && incoming().savedAt == request.time;
        allow delete: if isValidId(userId) && isValidId(postId) && isVerified() && isOwner(userId);
      }

      match /followers/{followerId} {
        allow get: if isValidId(userId) && isValidId(followerId) && isSignedIn();
        allow list: if isValidId(userId) && isSignedIn();
        allow create: if isValidId(userId) && isValidId(followerId)
          && userId != followerId
          && isVerified()
          && isOwner(followerId)
          && isValidFollowEdge(incoming())
          && incoming().uid == followerId
          && incoming().createdAt == request.time
          && isNotSuspended()
          && exists(/databases/$(database)/documents/users/$(userId))
          && existsAfter(/databases/$(database)/documents/users/$(followerId)/following/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(followerId)
          && userId != followerId
          && isVerified()
          && isOwner(followerId)
          && !existsAfter(/databases/$(database)/documents/users/$(followerId)/following/$(userId));
      }

      match /following/{targetId} {
        allow get: if isValidId(userId) && isValidId(targetId) && isSignedIn();
        allow list: if isValidId(userId) && isSignedIn();
        allow create: if isValidId(userId) && isValidId(targetId)
          && userId != targetId
          && isVerified()
          && isOwner(userId)
          && isValidFollowEdge(incoming())
          && incoming().uid == targetId
          && incoming().createdAt == request.time
          && isNotSuspended()
          && exists(/databases/$(database)/documents/users/$(targetId))
          && existsAfter(/databases/$(database)/documents/users/$(targetId)/followers/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(targetId)
          && userId != targetId
          && isVerified()
          && isOwner(userId)
          && !existsAfter(/databases/$(database)/documents/users/$(targetId)/followers/$(userId));
      }
    }

    // Per-user private preferences (chat pin/mute + recent searches)
    match /user_preferences/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isVerified() && isOwner(userId)
        && isValidUserPreferences(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isVerified() && isOwner(userId)
        && isValidUserPreferences(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time;
    }

    match /usernames/{username} {
      allow get: if isValidId(username);
      allow create: if isValidId(username) && isVerified()
        && isValidUsernameClaim(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(username) && isVerified()
        && isValidUsernameClaim(incoming())
        && existing().uid == request.auth.uid
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow delete: if isValidId(username) && isVerified() && existing().uid == request.auth.uid;
    }

    match /posts/{postId} {
      allow get: if isValidId(postId) && (existing().audience == 'public' || isSignedIn());
      allow list: if isSignedIn() && existing().audience in ['public', 'followers', 'space'];

      allow create: if isValidId(postId)
        && isVerified()
        && isNotSuspended()
        && isValidPost(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().repostsCount == 0
        && incoming().savesCount == 0
        && (!('giftsCount' in incoming()) || incoming().giftsCount == 0)
        && (!('collaboratorUids' in incoming()) || incoming().collaboratorUids.size() == 0)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(postId)
        && isVerified()
        && isValidPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || hasPerm('moderate_content') ||
          (
            isOwner(existing().authorId)
            && isNotSuspended()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'text', 'location', 'audience', 'hashtags', 'mentions',
              'taggedUids', 'taggedUsernames', 'collaboratorInviteUids', 'collaboratorProfiles', 'updatedAt'
            ])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'likesCount', 'commentsCount', 'repostsCount', 'savesCount', 'pollCounts', 'giftsCount', 'updatedAt'
            ])
          ) ||
          (
            isNotSuspended()
            && 'collaboratorInviteUids' in existing()
            && (request.auth.uid in existing().collaboratorInviteUids || ('collaboratorUids' in existing() && request.auth.uid in existing().collaboratorUids))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'collaboratorUids', 'declinedCollaboratorUids', 'collaboratorProfiles', 'updatedAt'
            ])
          ) ||
          (
            'taggedUids' in existing()
            && request.auth.uid in existing().taggedUids
            && incoming().diff(existing()).affectedKeys().hasOnly(['taggedUids', 'taggedUsernames', 'updatedAt'])
            && !(request.auth.uid in incoming().taggedUids)
          )
        );

      allow delete: if isValidId(postId) && isVerified() && (isOwner(existing().authorId) || isAdmin() || hasPerm('moderate_content'));

      match /likes/{userId} {
        allow get: if isValidId(postId) && isValidId(userId) && isSignedIn();
        allow list: if isValidId(postId) && isSignedIn();
        allow create: if isValidId(postId) && isValidId(userId) && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && isValidPostLike(incoming())
          && incoming().uid == userId
          && incoming().createdAt == request.time;
        allow delete: if isValidId(postId) && isValidId(userId) && isVerified() && isOwner(userId);
      }

      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId) && isSignedIn();
        allow list: if isValidId(postId) && isSignedIn();
        allow create: if isValidId(postId) && isValidId(commentId) && isVerified()
          && isNotSuspended()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && isValidPostComment(incoming())
          && incoming().postId == postId
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(postId) && isValidId(commentId) && isVerified() && (isOwner(existing().authorId) || isAdmin() || hasPerm('moderate_content'));
      }

      match /votes/{userId} {
        allow get: if isValidId(postId) && isValidId(userId) && isSignedIn();
        allow create: if isValidId(postId) && isValidId(userId) && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && isValidPostVote(incoming())
          && incoming().uid == userId
          && incoming().createdAt == request.time;
      }
    }

    match /stories/{storyId} {
      allow get: if isValidId(storyId) && isSignedIn();
      allow list: if isSignedIn() && existing().privacy in ['public', 'followers', 'close'];

      allow create: if isValidId(storyId)
        && isVerified()
        && isNotSuspended()
        && isValidStory(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().viewsCount == 0
        && incoming().createdAt == request.time;

      allow update: if isValidId(storyId)
        && isVerified()
        && isValidStory(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']);

      allow delete: if isValidId(storyId) && isVerified() && (isOwner(existing().authorId) || isAdmin() || hasPerm('moderate_content'));

      match /views/{viewerId} {
        allow get: if isValidId(storyId) && isValidId(viewerId) && isSignedIn();
        allow list: if isValidId(storyId) && isSignedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid;
        allow create: if isValidId(storyId) && isValidId(viewerId) && isVerified() && isOwner(viewerId)
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && isValidStoryView(incoming())
          && incoming().uid == viewerId
          && incoming().viewedAt == request.time;
        allow update: if isValidId(storyId) && isValidId(viewerId) && isVerified() && isOwner(viewerId)
          && isValidStoryView(incoming())
          && incoming().uid == existing().uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['reaction', 'viewedAt'])
          && incoming().viewedAt == request.time;
      }
    }

    match /vibes/{vibeId} {
      allow get: if isValidId(vibeId);
      allow list: if isSignedIn() && existing().viewsCount >= 0;

      allow create: if isValidId(vibeId)
        && isVerified()
        && isNotSuspended()
        && isValidVibe(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().repostsCount == 0
        && incoming().savesCount == 0
        && incoming().viewsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(vibeId)
        && isVerified()
        && isValidVibe(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || hasPerm('moderate_content') ||
          (
            isOwner(existing().authorId)
            && isNotSuspended()
            && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'hashtags', 'thumbnailUrl', 'updatedAt'])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'repostsCount', 'savesCount', 'viewsCount', 'updatedAt'])
          )
        );

      allow delete: if isValidId(vibeId) && isVerified() && (isOwner(existing().authorId) || isAdmin() || hasPerm('moderate_content'));

      match /likes/{userId} {
        allow get: if isValidId(vibeId) && isValidId(userId) && isSignedIn();
        allow list: if isValidId(vibeId) && isSignedIn();
        allow create: if isValidId(vibeId) && isValidId(userId) && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/vibes/$(vibeId))
          && isValidPostLike(incoming())
          && incoming().uid == userId
          && incoming().createdAt == request.time;
        allow delete: if isValidId(vibeId) && isValidId(userId) && isVerified() && isOwner(userId);
      }

      match /comments/{commentId} {
        allow get: if isValidId(vibeId) && isValidId(commentId) && isSignedIn();
        allow list: if isValidId(vibeId) && isSignedIn();
        allow create: if isValidId(vibeId) && isValidId(commentId) && isVerified()
          && isNotSuspended()
          && exists(/databases/$(database)/documents/vibes/$(vibeId))
          && isValidPostComment(incoming())
          && incoming().postId == vibeId
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(vibeId) && isValidId(commentId) && isVerified() && (isOwner(existing().authorId) || isAdmin() || hasPerm('moderate_content'));
      }
    }

    match /spaces/{spaceId} {
      allow get: if isValidId(spaceId);
      allow list: if isSignedIn() && existing().isPrivate in [false, true];

      allow create: if isValidId(spaceId)
        && isVerified()
        && isNotSuspended()
        && isValidSpace(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().verified == false
        && (!('status' in incoming()) || incoming().status in ['active', 'pending'])
        && incoming().membersCount == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(spaceId)
        && isVerified()
        && isValidSpace(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isPlatformOwner() || hasPerm('manage_communities') ||
          (
            incoming().ownerId == existing().ownerId
            && isOwner(existing().ownerId)
            && isNotSuspended()
            && incoming().verified == existing().verified
            && (!('status' in incoming()) ? !('status' in existing()) : ('status' in existing() && incoming().status == existing().status))
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'category', 'coverUrl', 'coverPositionY', 'isPrivate', 'updatedAt'])
          ) ||
          (
            incoming().ownerId == existing().ownerId
            && incoming().verified == existing().verified
            && (!('status' in incoming()) ? !('status' in existing()) : ('status' in existing() && incoming().status == existing().status))
            && incoming().diff(existing()).affectedKeys().hasOnly(['membersCount', 'updatedAt'])
          )
        );

      allow delete: if isValidId(spaceId) && isVerified() && (
        isOwner(existing().ownerId) || isPlatformOwner() || hasPerm('manage_communities') || hasPerm('moderate_content')
      );

      match /members/{userId} {
        allow get: if isValidId(spaceId) && isValidId(userId) && isSignedIn();
        allow list: if isValidId(spaceId) && isSignedIn();
        allow create: if isValidId(spaceId) && isValidId(userId) && isVerified()
          && (isOwner(userId) || isPlatformOwner() || hasPerm('manage_communities'))
          && (exists(/databases/$(database)/documents/spaces/$(spaceId)) || existsAfter(/databases/$(database)/documents/spaces/$(spaceId)))
          && isValidSpaceMember(incoming())
          && incoming().uid == userId
          && incoming().joinedAt == request.time
          && (
            isPlatformOwner() || hasPerm('manage_communities') ||
            incoming().role == 'member' ||
            (incoming().role == 'owner' && (
              (exists(/databases/$(database)/documents/spaces/$(spaceId)) && get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid) ||
              (existsAfter(/databases/$(database)/documents/spaces/$(spaceId)) && getAfter(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid)
            ))
          );
        allow update: if isValidId(spaceId) && isValidId(userId) && isVerified()
          && isValidSpaceMember(incoming())
          && (
            isPlatformOwner() || hasPerm('manage_communities') ||
            get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid
          )
          && incoming().uid == existing().uid
          && incoming().joinedAt == existing().joinedAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['role']);
        allow delete: if isValidId(spaceId) && isValidId(userId) && isVerified()
          && (
            isOwner(userId) ||
            isPlatformOwner() ||
            hasPerm('manage_communities') ||
            get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid
          );
      }

      match /discussions/{msgId} {
        allow get: if isValidId(spaceId) && isValidId(msgId) && isSignedIn()
          && (exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)) || isPlatformOwner() || hasPerm('moderate_content'));
        allow list: if isValidId(spaceId) && isSignedIn()
          && (exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)) || isPlatformOwner() || hasPerm('moderate_content'));
        allow create: if isValidId(spaceId) && isValidId(msgId) && isVerified()
          && isNotSuspended()
          && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid))
          && isValidSpaceDiscussion(incoming())
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(spaceId) && isValidId(msgId) && isVerified()
          && (isOwner(existing().authorId) || get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid || isPlatformOwner() || hasPerm('moderate_content'));
      }

      match /events/{eventId} {
        allow get: if isValidId(spaceId) && isValidId(eventId) && isSignedIn();
        allow list: if isValidId(spaceId) && isSignedIn();
        allow create: if isValidId(spaceId) && isValidId(eventId) && isVerified()
          && isNotSuspended()
          && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid))
          && isValidSpaceEvent(incoming())
          && incoming().hostId == request.auth.uid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(spaceId) && isValidId(eventId) && isVerified()
          && (isOwner(existing().hostId) || get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid || isPlatformOwner() || hasPerm('manage_communities'));
      }
    }

    match /conversations/{convId} {
      allow get: if isValidId(convId) && isSignedIn() && (
        (resource == null && convId.matches('^dm_.*')) ||
        (resource != null && request.auth.uid in existing().participantIds)
      );
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;

      allow create: if isValidId(convId)
        && isVerified()
        && isNotSuspended()
        && isValidConversation(incoming())
        && incoming().createdBy == request.auth.uid
        && request.auth.uid in incoming().participantIds
        && (
          incoming().isGroup == true ||
          (incoming().participantIds.size() == 2 && incoming().participantIds[0] != incoming().participantIds[1])
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(convId)
        && isVerified()
        && isNotSuspended()
        && isValidConversation(incoming())
        && request.auth.uid in existing().participantIds
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (
          (
            incoming().updatedAt == request.time
            && (
              (
                incoming().participantIds == existing().participantIds &&
                (
                  incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'updatedAt']) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'updatedAt', 'readBy', 'typingBy'])
                )
              ) ||
              (existing().isGroup == true && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'participantIds', 'participantNames', 'participantAvatars', 'updatedAt']))
            )
          ) ||
          (
            incoming().updatedAt == existing().updatedAt
            && incoming().participantIds == existing().participantIds
            && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'typingBy'])
          )
        );

      match /messages/{messageId} {
        allow get: if isValidId(convId) && isValidId(messageId) && isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow list: if isValidId(convId) && isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;

        allow create: if isValidId(convId) && isValidId(messageId) && isVerified()
          && isNotSuspended()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && isValidChatMessage(incoming())
          && incoming().senderId == request.auth.uid
          && incoming().edited == false
          && incoming().deleted == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(convId) && isValidId(messageId) && isVerified()
          && isNotSuspended()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && isValidChatMessage(incoming())
          && incoming().senderId == existing().senderId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isOwner(existing().senderId) && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'edited', 'deleted', 'updatedAt'])) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'updatedAt'])
          );
      }
    }

    match /notifications/{notifId} {
      allow get: if isValidId(notifId) && isSignedIn() && existing().recipientId == request.auth.uid;
      allow list: if isSignedIn() && existing().recipientId == request.auth.uid;

      allow create: if isValidId(notifId)
        && isVerified()
        && isValidNotification(incoming())
        && incoming().actorId == request.auth.uid
        && incoming().read == false
        && incoming().createdAt == request.time
        && (
          incoming().type in [
            'like', 'comment', 'reply', 'mention', 'follow', 'repost',
            'space_invite', 'space_announcement', 'event_reminder', 'message',
            'collab_invite', 'collab_response', 'post_tag', 'gift_received', 'support_ticket'
          ] ||
          (incoming().type in ['security_alert', 'subscription_notice', 'subscription_renewal', 'ai_welcome'] && incoming().recipientId == request.auth.uid) ||
          isPlatformOwner() ||
          hasPerm('manage_notifications') ||
          hasPerm('manage_verification') ||
          hasPerm('review_identity_docs') ||
          hasPerm('manage_communities') ||
          hasPerm('manage_admins') ||
          hasPerm('manage_platform') ||
          hasPerm('manage_rewards') ||
          hasPerm('manage_withdrawals')
        );

      allow update: if isValidId(notifId)
        && isVerified()
        && isOwner(existing().recipientId)
        && isValidNotification(incoming())
        && incoming().recipientId == existing().recipientId
        && incoming().actorId == existing().actorId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);

      allow delete: if isValidId(notifId) && isVerified() && isOwner(existing().recipientId);
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isVerified() && (
        isOwner(existing().reporterId) || isPlatformOwner() || hasPerm('moderate_content') || hasPerm('manage_communities')
      );
      allow list: if isVerified() && (isPlatformOwner() || hasPerm('moderate_content') || hasPerm('manage_communities'))
        && existing().targetType in ['post', 'user', 'space', 'vibe', 'gift', 'collab', 'message'];

      allow create: if isValidId(reportId) && isVerified()
        && isNotSuspended()
        && isValidReport(incoming())
        && incoming().reporterId == request.auth.uid
        && (!('status' in incoming()) || incoming().status == 'open')
        && incoming().createdAt == request.time;

      allow update: if isValidId(reportId) && isVerified()
        && isValidReport(incoming())
        && (isPlatformOwner() || hasPerm('moderate_content') || hasPerm('manage_communities'))
        && incoming().reporterId == existing().reporterId
        && incoming().targetType == existing().targetType
        && incoming().targetId == existing().targetId
        && incoming().createdAt == existing().createdAt
        && incoming().resolvedBy == request.auth.uid
        && incoming().resolvedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolutionNote', 'resolvedBy', 'resolvedAt']);
    }

    // Strictly Free Virtual Gifts Catalog
    match /gift_catalog/{giftId} {
      allow get: if isValidId(giftId) && isSignedIn();
      allow list: if isSignedIn() && existing().tier in ['free', 'future_premium'];

      allow create, update: if isValidId(giftId)
        && isVerified()
        && isValidGiftCatalogItem(incoming())
        && incoming().tier == 'free'
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('moderate_content'));

      allow delete: if isValidId(giftId)
        && isVerified()
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('moderate_content'));
    }

    // Free Virtual Gift Transactions
    match /virtual_gifts/{giftTxId} {
      allow get: if isValidId(giftTxId) && isSignedIn();
      allow list: if isSignedIn() && existing().targetType in ['profile', 'post'];

      allow create: if isValidId(giftTxId)
        && isVerified()
        && isNotSuspended()
        && isValidGiftTransaction(incoming())
        && incoming().senderUid == request.auth.uid
        && incoming().senderUid != incoming().recipientUid
        && incoming().createdAt == request.time;

      allow delete: if isValidId(giftTxId) && isVerified() && (
        isOwner(existing().senderUid) ||
        isOwner(existing().recipientUid) ||
        isPlatformOwner() ||
        hasPerm('moderate_content')
      );
    }

    // Privacy-Masked Email Dispatch Logs
    match /email_logs/{logId} {
      allow get: if isValidId(logId) && isVerified() && (
        isOwner(existing().actorUid) || isPlatformOwner() || hasPerm('manage_notifications') || hasPerm('manage_platform')
      );
      allow list: if isVerified()
        && (isPlatformOwner() || hasPerm('manage_notifications') || hasPerm('manage_platform'))
        && existing().status in ['sent', 'not_configured', 'skipped', 'failed'];

      allow create: if isValidId(logId)
        && isVerified()
        && isValidEmailLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // Support Tickets, Verification Help & Moderation Appeals
    match /contact_submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isVerified() && (
        ('uid' in existing() && isOwner(existing().uid)) ||
        isPlatformOwner() ||
        hasPerm('moderate_content') ||
        hasPerm('manage_notifications')
      );
      allow list: if isVerified()
        && (
          ('uid' in existing() && isOwner(existing().uid)) ||
          ((isPlatformOwner() || hasPerm('moderate_content') || hasPerm('manage_notifications')) && existing().status in ['open', 'in_review', 'resolved'])
        );

      allow create: if isValidId(submissionId)
        && isValidContactSubmission(incoming())
        && incoming().status == 'open'
        && (!('uid' in incoming()) || (isSignedIn() && incoming().uid == request.auth.uid))
        && !('handledBy' in incoming())
        && !('handledAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(submissionId)
        && isVerified()
        && isValidContactSubmission(incoming())
        && (isPlatformOwner() || hasPerm('moderate_content') || hasPerm('manage_notifications'))
        && incoming().createdAt == existing().createdAt
        && incoming().handledBy == request.auth.uid
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(submissionId) && isVerified() && (
        isPlatformOwner() || hasPerm('moderate_content')
      );
    }

    // Discord-Inspired Public Admin Presence (never exposes 'invisible')
    match /admin_presence/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && existing().status in ['online', 'idle', 'dnd', 'offline'];

      allow create, update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && (isPlatformOwner() || isActiveStaff())
        && isValidAdminPresencePublic(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(userId) && isVerified() && (
        isOwner(userId) || isPlatformOwner() || hasPerm('manage_admins')
      );
    }

    // Private Multi-Device Session & Manual Override Mode (Owner & Active Staff Only)
    match /admin_presence_private/{userId} {
      allow get: if isValidId(userId) && isVerified() && (
        (isOwner(userId) && (isPlatformOwner() || isActiveStaff())) ||
        isPlatformOwner() ||
        hasPerm('manage_admins')
      );
      allow list: if false;

      allow create, update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && (isPlatformOwner() || isActiveStaff())
        && isValidAdminPresencePrivate(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(userId) && isVerified() && (
        isPlatformOwner() || hasPerm('manage_admins')
      );
    }

    // Private Redacted System Error Diagnostics (Admin Inspection Only)
    match /error_diagnostics/{diagId} {
      allow get: if isValidId(diagId) && isVerified() && (
        isPlatformOwner() ||
        hasPerm('view_audit_logs') ||
        hasPerm('manage_admins') ||
        hasPerm('manage_platform')
      );
      allow list: if isVerified()
        && (
          isPlatformOwner() ||
          hasPerm('view_audit_logs') ||
          hasPerm('manage_admins') ||
          hasPerm('manage_platform')
        )
        && existing().category in ['upload', 'permission', 'network', 'auth', 'validation', 'runtime', 'unknown'];

      allow create: if isValidId(diagId)
        && isVerified()
        && isValidErrorDiagnostic(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().resolved == false
        && !('resolvedBy' in incoming())
        && !('resolvedAt' in incoming())
        && incoming().createdAt == request.time;

      allow update: if isValidId(diagId)
        && isVerified()
        && (
          isPlatformOwner() ||
          hasPerm('view_audit_logs') ||
          hasPerm('manage_admins') ||
          hasPerm('manage_platform')
        )
        && isValidErrorDiagnostic(incoming())
        && incoming().actorUid == existing().actorUid
        && incoming().createdAt == existing().createdAt
        && incoming().resolved == true
        && incoming().resolvedBy == request.auth.uid
        && incoming().resolvedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['resolved', 'resolvedBy', 'resolvedAt']);

      allow delete: if false;
    }

    // Creator Daily Aggregate Analytics (zero private viewer PII)
    match /creator_analytics_daily/{docId} {
      allow get: if isValidId(docId) && isVerified() && isOwner(existing().uid);
      allow list: if isVerified() && existing().uid == request.auth.uid;

      allow create: if isValidId(docId)
        && isVerified()
        && isValidCreatorAnalyticsDaily(incoming())
        && incoming().profileVisits <= 1
        && incoming().postImpressions <= 5
        && incoming().vibeViews <= 5
        && incoming().followersDelta >= -1 && incoming().followersDelta <= 1
        && incoming().updatedAt == request.time;

      allow update: if isValidId(docId)
        && isVerified()
        && isValidCreatorAnalyticsDaily(incoming())
        && incoming().uid == existing().uid
        && incoming().dateKey == existing().dateKey
        && incoming().updatedAt == request.time
        && incoming().profileVisits >= existing().profileVisits
        && incoming().profileVisits <= existing().profileVisits + 1
        && incoming().postImpressions >= existing().postImpressions
        && incoming().postImpressions <= existing().postImpressions + 5
        && incoming().vibeViews >= existing().vibeViews
        && incoming().vibeViews <= existing().vibeViews + 5;
    }

    // Subscription Plans Catalog (Admin-Managed)
    match /subscription_plans/{planId} {
      allow get: if isValidId(planId) && isSignedIn();
      allow list: if isSignedIn() && existing().id in ['free', 'plus', 'pro'];

      allow create, update: if isValidId(planId)
        && isVerified()
        && isValidSubscriptionPlan(incoming())
        && incoming().id == planId
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform'));

      allow delete: if isValidId(planId) && isVerified() && (isPlatformOwner() || hasPerm('manage_platform'));
    }

    // User Subscriptions (Admin or verified server checkout receipt)
    match /user_subscriptions/{userId} {
      allow get: if isValidId(userId) && isVerified() && (
        isOwner(userId) || isPlatformOwner() || hasPerm('manage_platform')
      );
      allow list: if isVerified()
        && (isPlatformOwner() || hasPerm('manage_platform'))
        && existing().tier in ['free', 'plus', 'pro'];

      allow create, update: if isValidId(userId)
        && isVerified()
        && isValidUserSubscription(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time
        && (
          isPlatformOwner() ||
          hasPerm('manage_platform') ||
          (
            isOwner(userId)
            && (
              (incoming().tier == 'free' && incoming().provider == 'free') ||
              (incoming().cancelAtPeriodEnd == true && existing() != null && incoming().tier == existing().tier) ||
              (incoming().provider == 'stripe' && incoming().verifiedByServer == true && incoming().lastSessionId is string && incoming().lastSessionId.matches('^cs_.*'))
            )
          )
        );
    }

    // Payment Transactions & Receipts
    match /payment_transactions/{txId} {
      allow get: if isValidId(txId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_platform')
      );
      allow list: if isVerified() && (
        isOwner(existing().uid) ||
        ((isPlatformOwner() || hasPerm('manage_platform')) && existing().status in ['paid', 'pending', 'failed', 'refunded', 'canceled'])
      );

      allow create: if isValidId(txId)
        && isVerified()
        && isValidPaymentTransaction(incoming())
        && incoming().createdAt == request.time
        && (
          isPlatformOwner() ||
          hasPerm('manage_platform') ||
          (
            isOwner(incoming().uid)
            && incoming().provider == 'stripe'
            && incoming().stripeSessionId is string
            && incoming().stripeSessionId.matches('^cs_.*')
          )
        );

      allow update: if isValidId(txId)
        && isVerified()
        && isValidPaymentTransaction(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (isPlatformOwner() || hasPerm('manage_platform'));
    }

    // Profile Customisation Studio Catalog (Admin-Managed)
    match /customisation_catalog/{itemId} {
      allow get: if isValidId(itemId) && isSignedIn();
      allow list: if isSignedIn() && existing().requiredTier in ['free', 'plus', 'pro'];

      allow create, update: if isValidId(itemId)
        && isVerified()
        && isValidCustomisationItem(incoming())
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform'));

      allow delete: if isValidId(itemId)
        && isVerified()
        && (isPlatformOwner() || hasPerm('manage_platform'));
    }

    // Private Personal Nexora AI Conversations (Strictly Owner-Only)
    match /ai_conversations/{convId} {
      allow get: if isValidId(convId) && isVerified() && isOwner(existing().uid);
      allow list: if isVerified() && existing().uid == request.auth.uid;

      allow create: if isValidId(convId)
        && isVerified()
        && isValidAIConversation(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(convId)
        && isVerified()
        && isOwner(existing().uid)
        && isValidAIConversation(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(convId) && isVerified() && isOwner(existing().uid);
    }

    // Private Personal Nexora AI Messages (Strictly Owner-Only)
    match /ai_messages/{msgId} {
      allow get: if isValidId(msgId) && isVerified() && isOwner(existing().uid);
      allow list: if isVerified() && existing().uid == request.auth.uid;

      allow create: if isValidId(msgId)
        && isVerified()
        && isValidAIMessage(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;

      allow delete: if isValidId(msgId) && isVerified() && isOwner(existing().uid);
    }

    // Global Nexora AI Settings (Owner / Platform Governance)
    match /ai_settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isSignedIn() && existing().enabled in [true, false];

      allow create, update: if settingId == 'global'
        && isVerified()
        && isValidAISettings(incoming())
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform'));
    }

    // Daily AI Usage & Token Telemetry
    match /ai_usage/{usageId} {
      allow get: if isValidId(usageId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_platform') || hasPerm('view_analytics')
      );
      allow list: if isVerified() && (
        existing().uid == request.auth.uid ||
        ((isPlatformOwner() || hasPerm('manage_platform') || hasPerm('view_analytics')) && existing().tier in ['free', 'plus', 'pro'])
      );

      allow create: if isValidId(usageId)
        && isVerified()
        && isValidAIUsage(incoming())
        && isOwner(incoming().uid)
        && incoming().requestsCount >= 0
        && incoming().requestsCount <= 10
        && incoming().updatedAt == request.time;

      allow update: if isValidId(usageId)
        && isVerified()
        && isValidAIUsage(incoming())
        && isOwner(existing().uid)
        && incoming().uid == existing().uid
        && incoming().dateKey == existing().dateKey
        && incoming().requestsCount >= existing().requestsCount
        && incoming().requestsCount <= existing().requestsCount + 10
        && incoming().updatedAt == request.time;
    }

    // Community AI Channel Configuration
    match /ai_channel_config/{channelId} {
      allow get: if isValidId(channelId) && isSignedIn();
      allow list: if isSignedIn() && existing().targetType in ['space', 'group_chat'];

      allow create, update: if isValidId(channelId)
        && isVerified()
        && isValidAIChannelConfig(incoming())
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('manage_communities'));

      allow delete: if isValidId(channelId)
        && isVerified()
        && (isPlatformOwner() || hasPerm('manage_platform') || hasPerm('manage_communities'));
    }

    // Owner-Approved Global Announcements Workflow
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isVerified() && (
        existing().status == 'published' ||
        isPlatformOwner() ||
        hasPerm('manage_notifications') ||
        hasPerm('manage_platform')
      );
      allow list: if isVerified() && (
        existing().status == 'published' ||
        ((isPlatformOwner() || hasPerm('manage_notifications') || hasPerm('manage_platform'))
          && existing().status in ['draft', 'approved', 'scheduled', 'published', 'failed'])
      );

      allow create: if isValidId(announcementId)
        && isVerified()
        && isValidAnnouncementRecord(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isPlatformOwner() ||
          (hasPerm('manage_notifications') && incoming().ownerApproved == false && incoming().status == 'draft')
        );

      allow update: if isValidId(announcementId)
        && isVerified()
        && isValidAnnouncementRecord(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isPlatformOwner() ||
          (hasPerm('manage_notifications') && existing().status == 'draft' && incoming().ownerApproved == false && incoming().status == 'draft')
        );

      allow delete: if isValidId(announcementId)
        && isVerified()
        && (isPlatformOwner() || (hasPerm('manage_notifications') && existing().status == 'draft'));
    }

    // Consented FCM Push Device Tokens
    match /device_tokens/{tokenId} {
      allow get: if isValidId(tokenId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_notifications')
      );
      allow list: if isVerified() && (
        existing().uid == request.auth.uid ||
        ((isPlatformOwner() || hasPerm('manage_notifications')) && existing().enabled in [true, false])
      );

      allow create: if isValidId(tokenId)
        && isVerified()
        && isValidDeviceToken(incoming())
        && isOwner(incoming().uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(tokenId)
        && isVerified()
        && isValidDeviceToken(incoming())
        && isOwner(existing().uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(tokenId) && isVerified() && isOwner(existing().uid);
    }

    // Software Release History & Owner Approval Gate
    match /release_history/{releaseId} {
      allow get: if isValidId(releaseId) && isVerified() && (
        existing().status == 'published' || isPlatformOwner() || hasPerm('manage_platform')
      );
      allow list: if isVerified() && (
        existing().status == 'published' ||
        ((isPlatformOwner() || hasPerm('manage_platform')) && existing().status in ['draft', 'published'])
      );

      allow create: if isValidId(releaseId)
        && isVerified()
        && isValidReleaseHistoryItem(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isPlatformOwner() ||
          (hasPerm('manage_platform') && incoming().ownerApproved == false && incoming().status == 'draft')
        );

      allow update: if isValidId(releaseId)
        && isVerified()
        && isValidReleaseHistoryItem(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isPlatformOwner() ||
          (hasPerm('manage_platform') && existing().status == 'draft' && incoming().ownerApproved == false && incoming().status == 'draft')
        );

      allow delete: if isValidId(releaseId) && isVerified() && isPlatformOwner();
    }

    // Immutable Delivery Telemetry Reports
    match /delivery_reports/{reportId} {
      allow get: if isValidId(reportId) && isVerified() && (
        isOwner(existing().createdBy) || isPlatformOwner() || hasPerm('manage_notifications') || hasPerm('manage_platform')
      );
      allow list: if isVerified() && (
        existing().createdBy == request.auth.uid ||
        ((isPlatformOwner() || hasPerm('manage_notifications') || hasPerm('manage_platform'))
          && existing().sourceType in ['welcome', 'announcement', 'release', 'test'])
      );

      allow create: if isValidId(reportId)
        && isVerified()
        && isValidDeliveryReport(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && (
          (incoming().sourceType == 'welcome' && incoming().sourceId == request.auth.uid) ||
          isPlatformOwner() ||
          hasPerm('manage_notifications') ||
          hasPerm('manage_platform')
        );

      allow update, delete: if false;
    }

    // --- Rewards, Invitations, Free Tasks, Wallets & Bank Withdrawals ---

    match /rewards_config/{configId} {
      allow get: if isValidId(configId) && configId == 'global' && isSignedIn();
      allow list: if false;

      allow create: if configId == 'global'
        && isVerified()
        && isValidRewardsConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && isPlatformOwner();

      allow update: if configId == 'global'
        && isVerified()
        && isValidRewardsConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          isPlatformOwner() ||
          (
            (hasPerm('manage_rewards') || hasPerm('manage_withdrawals') || hasPerm('manage_platform')) &&
            (
              (!('pointRateNaira' in existing()) && (!('pointRateNaira' in incoming()) || incoming().pointRateNaira == null)) ||
              ('pointRateNaira' in existing() && 'pointRateNaira' in incoming() && incoming().pointRateNaira == existing().pointRateNaira)
            )
          )
        );
    }

    match /invitations/{code} {
      allow get: if isValidId(code) && isSignedIn();
      allow list: if isVerified() && (
        existing().ownerUid == request.auth.uid ||
        ((isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform')) && existing().kind in ['personal', 'admin'])
      );

      allow create: if isValidId(code)
        && isVerified()
        && isNotSuspended()
        && isValidInvitationRecord(incoming())
        && incoming().code == code
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().totalRegistrations == 0
        && incoming().qualifiedReferralsCount == 0
        && incoming().milestonesAwarded == 0
        && incoming().pointsEarned == 0
        && (
          (incoming().kind == 'personal' && incoming().ownerUid == request.auth.uid) ||
          (incoming().kind == 'admin' && (isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform')))
        );

      allow update: if isValidId(code)
        && isVerified()
        && isValidInvitationRecord(incoming())
        && incoming().code == existing().code
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isPlatformOwner() ||
          hasPerm('manage_rewards') ||
          hasPerm('manage_platform') ||
          (
            isOwner(existing().ownerUid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt'])
          )
        );

      allow delete: if isValidId(code) && isVerified() && isPlatformOwner();
    }

    match /referral_claims/{inviteeUid} {
      allow get: if isValidId(inviteeUid) && isVerified() && (
        isOwner(inviteeUid) ||
        isOwner(existing().inviterUid) ||
        isPlatformOwner() ||
        hasPerm('manage_rewards') ||
        hasPerm('manage_platform')
      );
      allow list: if isVerified() && (
        existing().inviteeUid == request.auth.uid ||
        existing().inviterUid == request.auth.uid ||
        ((isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform')) && existing().status in ['pending', 'qualified', 'flagged', 'rejected'])
      );

      allow create: if isValidId(inviteeUid)
        && isVerified()
        && isNotSuspended()
        && isOwner(inviteeUid)
        && isValidReferralClaim(incoming())
        && incoming().inviteeUid == inviteeUid
        && incoming().inviterUid != inviteeUid
        && incoming().status == 'pending'
        && incoming().rewardStatus == 'uncounted'
        && !('qualifiedAt' in incoming())
        && incoming().registeredAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/invitations/$(incoming().invitationCode));

      allow update: if isValidId(inviteeUid)
        && isVerified()
        && isValidReferralClaim(incoming())
        && incoming().inviteeUid == existing().inviteeUid
        && incoming().inviterUid == existing().inviterUid
        && incoming().invitationCode == existing().invitationCode
        && incoming().registeredAt == existing().registeredAt
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform'));

      allow delete: if false;
    }

    match /referral_fraud_alerts/{alertId} {
      allow get: if isValidId(alertId) && isVerified() && (
        isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform')
      );
      allow list: if isVerified()
        && (isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform'))
        && existing().status in ['open', 'dismissed', 'confirmed_fraud'];

      allow create, update: if isValidId(alertId)
        && isVerified()
        && isValidReferralFraudAlert(incoming())
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform'));

      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && isSignedIn() && existing().freeToParticipate == true;
      allow list: if isSignedIn() && existing().freeToParticipate == true;

      allow create: if isValidId(taskId)
        && isVerified()
        && isValidTaskItem(incoming())
        && incoming().freeToParticipate == true
        && incoming().submissionsCount == 0
        && incoming().approvedCount == 0
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform'));

      allow update: if isValidId(taskId)
        && isVerified()
        && isValidTaskItem(incoming())
        && incoming().freeToParticipate == true
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform'));

      allow delete: if isValidId(taskId) && isVerified() && (
        isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform')
      );
    }

    match /task_submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform')
      );
      allow list: if isVerified() && (
        existing().uid == request.auth.uid ||
        ((isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_platform')) && existing().status in ['pending', 'approved', 'rejected'])
      );

      allow create: if isValidId(submissionId)
        && isVerified()
        && isNotSuspended()
        && isValidTaskSubmission(incoming())
        && incoming().uid == request.auth.uid
        && submissionId == (incoming().taskId + '_' + incoming().uid)
        && incoming().status == 'pending'
        && !('reviewerUid' in incoming())
        && !('reviewerNote' in incoming())
        && !('reviewedAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/tasks/$(incoming().taskId))
        && taskData(incoming().taskId).freeToParticipate == true
        && taskData(incoming().taskId).active == true
        && incoming().rewardPoints == taskData(incoming().taskId).rewardPoints;

      allow update: if isValidId(submissionId)
        && isVerified()
        && isValidTaskSubmission(incoming())
        && incoming().taskId == existing().taskId
        && incoming().uid == existing().uid
        && incoming().rewardPoints == existing().rewardPoints
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().reviewerUid == request.auth.uid
        && (isPlatformOwner() || ((hasPerm('manage_rewards') || hasPerm('manage_platform')) && existing().uid != request.auth.uid));

      allow delete: if false;
    }

    match /wallets/{userId} {
      allow get: if isValidId(userId) && isVerified() && (
        isOwner(userId) || isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_withdrawals') || hasPerm('manage_platform')
      );
      allow list: if isVerified()
        && (isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_withdrawals') || hasPerm('manage_platform'))
        && existing().availablePoints >= 0;

      allow create, update: if isValidId(userId)
        && isVerified()
        && isValidWalletAccount(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time
        && (isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_withdrawals') || hasPerm('manage_platform'));

      allow delete: if false;
    }

    match /wallet_transactions/{txId} {
      allow get: if isValidId(txId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_withdrawals') || hasPerm('manage_platform')
      );
      allow list: if isVerified() && (
        existing().uid == request.auth.uid ||
        ((isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_withdrawals') || hasPerm('manage_platform')) && existing().direction in ['credit', 'debit'])
      );

      allow create: if isValidId(txId)
        && isVerified()
        && isValidWalletTransaction(incoming())
        && incoming().createdAt == request.time
        && (isPlatformOwner() || hasPerm('manage_rewards') || hasPerm('manage_withdrawals') || hasPerm('manage_platform'));

      allow update, delete: if false;
    }

    match /withdrawal_requests/{withdrawalId} {
      allow get: if isValidId(withdrawalId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_withdrawals') || hasPerm('manage_platform')
      );
      allow list: if isVerified() && (
        existing().uid == request.auth.uid ||
        ((isPlatformOwner() || hasPerm('manage_withdrawals') || hasPerm('manage_platform')) && existing().status in ['pending', 'under_review', 'approved', 'rejected', 'processing', 'paid'])
      );

      allow create: if isValidId(withdrawalId)
        && isVerified()
        && isNotSuspended()
        && isValidWithdrawalRequest(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && !('paymentReference' in incoming())
        && !('paidBy' in incoming())
        && !('paidAt' in incoming())
        && !('reviewedBy' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/rewards_config/global)
        && rewardsConfigData().withdrawalsOpen == true
        && 'pointRateNaira' in rewardsConfigData()
        && rewardsConfigData().pointRateNaira is number
        && rewardsConfigData().pointRateNaira > 0
        && incoming().pointRateNaira == rewardsConfigData().pointRateNaira
        && incoming().nairaAmount >= rewardsConfigData().minWithdrawalNaira
        && exists(/databases/$(database)/documents/wallets/$(request.auth.uid))
        && walletData(request.auth.uid).frozen != true
        && walletData(request.auth.uid).availablePoints >= incoming().pointsRequested;

      allow update: if isValidId(withdrawalId)
        && isVerified()
        && isValidWithdrawalRequest(incoming())
        && incoming().uid == existing().uid
        && incoming().pointsRequested == existing().pointsRequested
        && incoming().pointRateNaira == existing().pointRateNaira
        && incoming().nairaAmount == existing().nairaAmount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (incoming().status != 'paid' || ('paymentReference' in incoming() && incoming().paymentReference is string && incoming().paymentReference.size() >= 3))
        && (isPlatformOwner() || hasPerm('manage_withdrawals') || hasPerm('manage_platform'));

      allow delete: if false;
    }

    match /withdrawal_private/{withdrawalId} {
      allow get: if isValidId(withdrawalId) && isVerified() && (
        isOwner(existing().uid) || isPlatformOwner() || hasPerm('manage_withdrawals') || hasPerm('manage_platform')
      );
      allow list: if false;

      allow create: if isValidId(withdrawalId)
        && isVerified()
        && isNotSuspended()
        && isValidWithdrawalPrivate(incoming())
        && incoming().withdrawalId == withdrawalId
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
